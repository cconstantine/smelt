# Generated by Cargo
/target
/dist
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Claude Code's own directory stays out of the repo, with one exception
# (SME-247): `.claude/agents` is a symlink to `.agents/personas/`, so the
# repo's persona files are Claude Code subagents too. Git cannot
# re-include a file under an ignored directory, hence `/.claude/*` with
# the negation — not `.claude/`. src/repo_lints/personas.rs asserts the
# symlink is tracked, so re-ignoring it fails CI instead of vanishing
# from fresh clones.
/.claude/*
!/.claude/agents

.env

# Credential for the local k3s cluster's smelt-park namespace (bearer token
# inline) — same category as .env, never committed. See docs/setup.md.
.kubeconfig.yaml

# scripts/pm-wait-for-board's Linear API key (the user's, read-only), at the
# main checkout's root so a reboot keeps it.
/.linear-api-key

# Downloaded by scripts/browser-check/setup.sh — a headless Chrome binary
# and its shared libraries, never committed. See docs/testing.md.
/.browser-check-cache/

# CI's build caches (.github/workflows/ci.yml), when the runner has no
# cache volume of its own — never committed.
/.ci-cache/

__pycache__/

# scripts/check-server and scripts/ui-check (SME-51)
.check-server.pid
.check-server.log
.check-server.scratch-db
# The KUBECONFIG a check server was started with, for `stop`'s cleanup
# (SME-129).
.check-server.kubeconfig
ui-check-out/
