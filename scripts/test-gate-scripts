#!/usr/bin/env bash
# The scripts a session runs for the gate and for hands-on checks delete
# no files (SME-107), and check.sh, browser-tier and cluster-test run
# their tests under the cluster lock and build unlocked (SME-100). The
# stubs and helpers are in scripts/lib/test-check-scripts.sh.
#
#   scripts/test-gate-scripts
. "$(dirname "$0")/lib/test-check-scripts.sh"

# None of the scripts the gate or a hands-on check runs removes a file.
for script in scripts/check-server scripts/browser-tier scripts/check.sh scripts/cargo-fetch scripts/lint-expects scripts/build-sandbox-image.sh \
    scripts/with-cluster-lock scripts/cluster-test scripts/clean-test-namespace.sh; do
    if found=$(grep -nE '(^|[^[:alnum:]_-])(rm|rmdir|unlink|shred)([[:space:]]|$)|-delete([[:space:]]|$)' "$script" | grep -vE '^[0-9]+:[[:space:]]*#'); then
        fail "$script removes files: $found"
    fi
done


# SMELT_SKIP_SCRIPT_TESTS asks check.sh not to run its own scripts/test-*
# step: this suite does run check.sh, and the nested run would run this
# suite again, under stubs, recursing and polluting the calls recorded below.
export CALLS=$dir/calls
# No pauses between scripts/cargo-fetch's attempts, and none of the
# caller's offline setting (SME-442).
gate_env=(env -u SANDBOX_IMAGE -u CARGO_FAIL -u CARGO_WARN -u CARGO_FAIL_TIMES -u CARGO_FAIL_COUNT -u CALLS_ENV
    -u CARGO_SPURIOUS -u CARGO_NET_OFFLINE PATH="$dir/bin:$PATH" SANDBOX_IMAGE_IMPORT="$dir/bin/import" CARGO_FETCH_PAUSES="0 0"
    DATABASE_URL=postgres://u@localhost/smelt_dev BROWSER_CHECK_CACHE="$dir" SMELT_SKIP_SCRIPT_TESTS=1)
calls_env=$dir/calls-env
fail_count=$dir/cargo-fail-count
# Never the real cargo or dx: that would build, and run the real tests.
for tool in cargo dx sqlx; do
    [ "$("${gate_env[@]}" bash -c "command -v $tool")" = "$dir/bin/$tool" ] || {
        echo "the $tool stub isn't first on PATH; stopping before running any gate script" >&2
        exit 1
    }
done
wasm_check="cargo check --no-default-features --features web --target wasm32-unknown-unknown"
lints="-- -D warnings -A clippy::all -D clippy::expect_used -D clippy::unwrap_used -D clippy::too_many_lines"

# 7. check.sh builds, lints, compiles the tests and checks the cluster
# unlocked, and takes the lock for the test run only.
: >"$CALLS"
: >"$calls_env"
if ! out=$(timeout 60 "${gate_env[@]}" CALLS_ENV="$calls_env" scripts/check.sh 2>&1); then
    fail "check.sh with stubs failed: $out"
fi
# The crates are fetched first (SME-442).
expected="cargo fetch unlocked
$wasm_check unlocked
cargo build --features server unlocked
cargo clippy --version unlocked
cargo clippy --features server $lints unlocked
cargo clippy --no-default-features --features web --target wasm32-unknown-unknown $lints unlocked
cargo test --features server --no-run unlocked
import unlocked
import unlocked
cargo test --features server locked"
# Two `import`s since SME-391: the doctor checks the sandbox image and then
# the pre-pull list, both through the same read-only tool.
[ "$(cat "$CALLS")" = "$expected" ] || fail "check.sh's calls: $(cat "$CALLS")"
# The fetch itself is online, and every cargo call after it offline, so no
# build's output can carry a network retry's warning (SME-442).
[ "$(head -1 "$calls_env")" = "CARGO_NET_OFFLINE=<unset> cargo fetch" ] ||
    fail "check.sh's fetch didn't run online first: $(cat "$calls_env")"
online=$(tail -n +2 "$calls_env" | grep -v '^CARGO_NET_OFFLINE=true ')
[ "$(wc -l <"$calls_env")" -gt 1 ] && [ -z "$online" ] ||
    fail "check.sh ran cargo after the fetch without CARGO_NET_OFFLINE=true: $(cat "$calls_env")"
# A fetch that fails twice and then succeeds lets the gate go on, saying so.
: >"$CALLS"
echo 0 >"$fail_count"
if ! out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL='^fetch' CARGO_FAIL_TIMES=2 CARGO_FAIL_COUNT="$fail_count" scripts/check.sh 2>&1); then
    fail "check.sh failed on a fetch that succeeded at its third attempt: $out"
fi
grep -q "attempt 1 of 3 failed" <<<"$out" && grep -q "attempt 2 of 3 failed" <<<"$out" ||
    fail "check.sh didn't say the fetch's first two attempts failed: $out"
[ "$(grep -c '^cargo fetch ' "$CALLS")" = 3 ] || fail "check.sh didn't fetch three times: $(cat "$CALLS")"
# The retries it says it absorbed are the successful attempt's only, not a
# failed attempt's too (review 1, L2): each attempt here prints one.
echo 0 >"$fail_count"
out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL='^fetch' CARGO_FAIL_TIMES=1 CARGO_FAIL_COUNT="$fail_count" \
    CARGO_SPURIOUS='^fetch' scripts/cargo-fetch 2>&1) || fail "cargo-fetch failed on a second attempt that succeeded: $out"
grep -q "crates fetched on attempt 2 of 3 (1 network retries absorbed" <<<"$out" ||
    fail "cargo-fetch didn't count only the successful attempt's one retry: $out"
# Three failed fetches stop the gate before any build, saying crates.io is
# unreachable rather than showing a build failure.
: >"$CALLS"
echo 0 >"$fail_count"
if out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL='^fetch' CARGO_FAIL_TIMES=3 CARGO_FAIL_COUNT="$fail_count" scripts/check.sh 2>&1); then
    fail "check.sh passed with every fetch failing: $out"
fi
grep -q "^crates.io unreachable: cargo fetch failed 3 times" <<<"$out" ||
    fail "check.sh didn't say crates.io was unreachable: $out"
[ "$(cat "$CALLS")" = "cargo fetch unlocked
cargo fetch unlocked
cargo fetch unlocked" ] || fail "check.sh did more than fetch after three failed fetches: $(cat "$CALLS")"
# build-sandbox-image.sh fetches before its first cargo build too: it is the
# first cargo step of a seat's stack and of CI's start-stack (review 1, L1).
# A failing build stops it there, before any docker call; a docker stub that
# fails keeps a regression from building and importing for real.
mkdir -p "$dir/bin-no-docker"
printf '#!/usr/bin/env bash\necho "stub docker: not for these cases" >&2\nexit 1\n' >"$dir/bin-no-docker/docker"
chmod +x "$dir/bin-no-docker/docker"
image_env=("${gate_env[@]}" PATH="$dir/bin-no-docker:$dir/bin:$PATH")
: >"$CALLS"
timeout 60 "${image_env[@]}" CARGO_FAIL='^build' scripts/build-sandbox-image.sh >/dev/null 2>&1
[ "$(cat "$CALLS")" = "cargo fetch unlocked
cargo build --bin sandbox_agent --features server unlocked" ] ||
    fail "build-sandbox-image.sh didn't fetch before its build: $(cat "$CALLS")"
: >"$CALLS"
echo 0 >"$fail_count"
if out=$(timeout 60 "${image_env[@]}" CARGO_FAIL='^fetch' CARGO_FAIL_TIMES=3 CARGO_FAIL_COUNT="$fail_count" \
    scripts/build-sandbox-image.sh 2>&1); then
    fail "build-sandbox-image.sh passed with every fetch failing: $out"
fi
grep -q "^crates.io unreachable: cargo fetch failed 3 times" <<<"$out" ||
    fail "build-sandbox-image.sh didn't say crates.io was unreachable: $out"
[ "$(grep -vc '^cargo fetch ' "$CALLS")" = 0 ] ||
    fail "build-sandbox-image.sh built after three failed fetches: $(cat "$CALLS")"
# A test build that fails stops check.sh before the lock.
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/check.sh 2>&1); then
    fail "check.sh passed with a failing test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "check.sh took the lock after a failing test build: $(cat "$CALLS")"
grep -q "stub cargo told to fail" <<<"$out" || fail "check.sh didn't show the test build's error: $out"
# A test build with a warning stops it too, before the lock, showing the
# warning: test-only code is compiled nowhere else (SME-361).
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_WARN="--no-run" scripts/check.sh 2>&1); then
    fail "check.sh passed with a warning in the test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "check.sh took the lock after a test build with a warning: $(cat "$CALLS")"
grep -q "unused variable" <<<"$out" || fail "check.sh didn't show the test build's warning: $out"
grep -q "the server tests' build has warnings" <<<"$out" || fail "check.sh didn't say the test build warned: $out"

# 7b. ci-no-warnings (SME-361): a warning before the first `Running` line
# fails, one a test's subprocess prints after it doesn't, and a clean log
# passes.
ci_log=$dir/ci-test.log
printf '   Compiling smelt v0.1.0\nwarning: unused variable: `pod`\n   --> src/x.rs:1:9\n    Finished `test` profile\n     Running unittests src/main.rs\ntest result: ok.\n' >"$ci_log"
if out=$(scripts/ci-no-warnings "$ci_log" 2>&1); then
    fail "ci-no-warnings passed a log with a compile warning: $out"
fi
grep -q "unused variable" <<<"$out" || fail "ci-no-warnings didn't show the warning: $out"
printf '   Compiling smelt v0.1.0\n    Finished `test` profile\n     Running unittests src/main.rs\nwarning: a subprocess said this\ntest result: ok.\n' >"$ci_log"
out=$(scripts/ci-no-warnings "$ci_log" 2>&1) || fail "ci-no-warnings failed on a warning after Running: $out"
: >"$ci_log"
out=$(scripts/ci-no-warnings "$ci_log" 2>&1) || fail "ci-no-warnings failed on an empty log: $out"

# 7c. browser-tier stops on a warning in its test build, before the lock.
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_WARN="browser-test.*--no-run" scripts/browser-tier 2>&1); then
    fail "browser-tier passed with a warning in its test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "browser-tier took the lock after a build with a warning: $(cat "$CALLS")"
grep -q "unused variable" <<<"$out" || fail "browser-tier didn't show its build's warning: $out"

# 8. browser-tier likewise: the bundle, the test build and the scratch
# database unlocked, the tier's run locked.
: >"$CALLS"
: >"$calls_env"
if ! out=$(timeout 60 "${gate_env[@]}" CALLS_ENV="$calls_env" scripts/browser-tier 2>&1); then
    fail "browser-tier with stubs failed: $out"
fi
tier_db=postgres://u@localhost/smelt_browser_tier_$(basename "$PWD" | tr -c 'a-zA-Z0-9\n' '_')
expected="cargo fetch unlocked
import unlocked
import unlocked
dx build --platform web --verbose unlocked
cargo test --features server browser-test --no-run unlocked
sqlx database drop -y --database-url $tier_db unlocked
sqlx database create --database-url $tier_db unlocked
cargo test --features server browser-test -- --ignored --test-threads=1 locked
sqlx database drop -y --database-url $tier_db unlocked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "browser-tier's calls: $(cat "$CALLS")"
# Its fetch online, its two cargo tests offline (SME-442).
expected="CARGO_NET_OFFLINE=<unset> cargo fetch
CARGO_NET_OFFLINE=true cargo test --features server browser-test --no-run
CARGO_NET_OFFLINE=true cargo test --features server browser-test -- --ignored --test-threads=1"
[ "$(cat "$calls_env")" = "$expected" ] || fail "browser-tier's cargo calls' CARGO_NET_OFFLINE: $(cat "$calls_env")"
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/browser-tier 2>&1); then
    fail "browser-tier passed with a failing test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "browser-tier took the lock after a failing test build: $(cat "$CALLS")"

# 8b. browser-tier bounds its web-bundle step (SME-457): a bundle build that
# logs nothing and never exits — the shape of the stalled rustup toolchain
# download behind dx's unit-count estimate — must fail the tier within its
# cap, naming the step, not hang it. CI_WEB_BUNDLE_DX points the watched
# bundle build at a stub that sleeps silently; SMELT_BROWSER_TIER_BUNDLE_TIMEOUT=6
# is the cap, and this case's own timeout 90 guard is what a missing cap
# fails by — it never gets to run for 90 s.
hang_dx=$dir/hang-dx.sh
printf '#!/usr/bin/env bash\n# logs nothing, never exits, like the stalled download\nexec sleep 60\n' >"$hang_dx"
chmod +x "$hang_dx"
out=$(timeout 90 "${gate_env[@]}" SMELT_BROWSER_TIER_BUNDLE_TIMEOUT=6 CI_WEB_BUNDLE_DX="$hang_dx" scripts/browser-tier 2>&1)
rc=$?
[ "$rc" -ne 0 ] || fail "browser-tier passed a bundle step that hangs (rc $rc): $out"
grep -q "web bundle step timed out" <<<"$out" || fail "browser-tier didn't name the timed-out web bundle step (rc $rc): $out"

# 9. cluster-test: the same cargo test, built with --no-run unlocked (before
# the first --, or last when there's none), then run locked.
: >"$CALLS"
timeout 60 "${gate_env[@]}" scripts/cluster-test --features server -- --exact a::b >/dev/null 2>&1 ||
    fail "cluster-test failed"
expected="cargo test --features server --no-run -- --exact a::b unlocked
cargo test --features server -- --exact a::b locked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "cluster-test's calls: $(cat "$CALLS")"
: >"$CALLS"
timeout 60 "${gate_env[@]}" scripts/cluster-test --features server sweep >/dev/null 2>&1 || fail "cluster-test without -- failed"
expected="cargo test --features server sweep --no-run unlocked
cargo test --features server sweep locked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "cluster-test's calls without --: $(cat "$CALLS")"
: >"$CALLS"
timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/cluster-test --features server >/dev/null 2>&1
rc=$?
[ "$rc" = 101 ] || fail "cluster-test with a failing build exited $rc, not the build's 101"
grep -q " locked$" "$CALLS" && fail "cluster-test took the lock after a failing build: $(cat "$CALLS")"
unset CALLS

finish
