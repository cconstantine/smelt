#!/usr/bin/env bash
# Checks the cluster the tests use before they run (SME-53's retrospective),
# so a missing sandbox image is one clear message instead of every
# real-cluster test failing with ErrImageNeverPull: the node must have the
# image the tests will use and the Docker sidecar's, via the read-only
# `sandbox_image_import --check`, and (SME-391) warns, without failing, when
# it lacks one of `scripts/cluster-prepull-images.txt` — the catalog images
# `scripts/k3s-bootstrap.sh` pre-pulls, so a missing one reads here as a hint
# to re-run the bootstrap rather than mid-suite as the flake it was.
# `SMELT_SKIP_PREPULL=1` opts out of that check as it does of the pre-pull.
# The kubelet deletes unused images once
# its disk is over 85% full, so the check also warns (on stderr, without
# failing) when the node's image disk is within 15 GiB of that, naming the
# images no container uses (SME-229).
#
# The image is SANDBOX_IMAGE when set (scripts/check.sh sets it), else this
# working tree's own (`scripts/sandbox-image-ref`): named after the agent
# sources it was built from, so whichever checkout built it, it's this
# tree's agent (SME-102, SME-84). No record file. It's also the image a
# server built from this tree runs when SANDBOX_IMAGE is unset (SME-121).
#
# Run by scripts/check.sh and scripts/browser-tier before their tests;
# exits non-zero with what to do. SANDBOX_IMAGE_IMPORT replaces the import
# tool (scripts/test-cluster-doctor's stub).
set -euo pipefail
cd "$(dirname "$0")/.."

own=$(scripts/sandbox-image-ref)
image=${SANDBOX_IMAGE:-$own}
docker_image=${SANDBOX_DOCKER_IMAGE:-docker.io/library/docker:29-dind}

if [ -n "${SANDBOX_IMAGE_IMPORT:-}" ]; then
    check=("$SANDBOX_IMAGE_IMPORT")
else
    check=(cargo run -q --bin sandbox_image_import --features server --)
fi

if ! "${check[@]}" --check "$image" "$docker_image"; then
    if [ "$image" = "$own" ]; then
        echo "cluster-doctor: the cluster has no $image (this working tree's agent sources) or no $docker_image; run scripts/build-sandbox-image.sh" >&2
    else
        echo "cluster-doctor: the cluster has no $image (SANDBOX_IMAGE) or no $docker_image; build that image, or unset SANDBOX_IMAGE and run scripts/build-sandbox-image.sh" >&2
    fi
    exit 1
fi
echo "cluster-doctor: the cluster has $image"

# The catalog images the test pods start from (SME-391): the bootstrap
# pre-pulls them; warn, without failing, when the node has lost one (the
# kubelet GCs unused images), since the tests then live-pull mid-suite and
# can meet the flake SME-391 filed. SMELT_SKIP_PREPULL=1 opted out of the
# pre-pull on a machine that can't reach Docker Hub — don't nag about it.
if [ "${SMELT_SKIP_PREPULL:-}" != 1 ]; then
    mapfile -t prepull < <(grep -Ev '^[[:space:]]*(#|$)' scripts/cluster-prepull-images.txt)
    if [ "${#prepull[@]}" -gt 0 ]; then
        out=$("${check[@]}" --check "${prepull[@]}" 2>&1) \
            || {
                echo "cluster-doctor: warning: the node lacks a pre-pulled test image; the LSP catalog tests will live-pull from Docker Hub and may flake (SME-391); re-run: docker compose up --exit-code-from k3s-bootstrap k3s-bootstrap" >&2
                # The tool's message names what's missing and why, but its own
                # remedy is scripts/build-sandbox-image.sh — right for the
                # sandbox image, wrong for images the bootstrap pre-pulls.
                # Keep the diagnosis, drop that clause; the remedy above is
                # this check's.
                sed -e 's/; free up space if need be, then run scripts\/build-sandbox-image\.sh/; free up space if need be/' <<<"$out" | sed 's/^/  /' >&2
            }
    fi
fi
