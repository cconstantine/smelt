#!/usr/bin/env python3
"""Block until a Linear project's tickets need the Project Manager, then exit.

The Project Manager runs this as a background command, with --project naming
the project the user directed it to; it watches only that project's tickets
(the "board"). It exits, which wakes the Project Manager, as soon as a status
change on the board needs acting on:

  - a ticket enters Up Next, Todo or Approved;
  - a ticket reaches Done while it blocks a ticket that isn't Done
    (a waiting Up Next ticket may be plannable now).

Everything else (sub-agents finishing, CI) already wakes the Project Manager
through the sub-agents' own reports, so this only watches statuses.

It polls Linear's GraphQL API every --interval seconds (default 60) and
compares the board with a snapshot kept in
~/.local/state/smelt/pm-board-snapshot-<project>.json (or $SMELT_PM_STATE_DIR),
one per project, so switching projects reports nothing stale. Each
poll is compared with the one before it, and the snapshot is saved after
every successful poll, so a ticket that leaves a wake state and comes back
(Up Next -> Planned -> Up Next, a plan being revised) wakes it when a poll
sees it return. The snapshot is loaded when the script starts, so the first
poll is compared with the board at the previous run's last successful poll,
and a change made after it (by the user, or by the Project Manager's own
pass) is reported at once. The Project Manager's own moves therefore cause at
most one extra wake. A ticket that leaves and comes back between two polls,
or while no run is going, is missed: no poll saw it leave.

The API key is a Linear personal API key (read-only is enough), read from
.linear-api-key at the root of the main checkout (gitignored; one key for
every worktree), or the file $SMELT_LINEAR_KEY_FILE names. The
file must not be readable by group or others (chmod 600). The key is never
printed.

Exit status: 0 with one line per change on stdout; 1 for --once with nothing
changed; 2 when the key is missing, refused (401/403, no retry), the API keeps
failing, or the snapshot can't be saved (the message says why; any change
lines are printed first). With --once a failed poll isn't retried.

    scripts/pm-wait-for-board --project "Bug bash 4"          # wait for the next change
    scripts/pm-wait-for-board --project "Bug bash 4" --once   # check once: report and exit 0, or exit 1 if nothing changed
    scripts/pm-wait-for-board --self-test     # run its tests (no network; a temporary state dir, never the real one)
"""

import argparse
import contextlib
import io
import json
import os
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

API_URL = os.environ.get("SMELT_LINEAR_API_URL", "https://api.linear.app/graphql")
# The Linear project the Project Manager is directed to (--project). It only
# runs that project's tickets, so it watches only them.
PROJECT = None
WAKE_STATES = ("Up Next", "Todo", "Approved")
DONE = "Done"
MAX_FAILURES = 10

QUERY = """
query Board($project: String!, $after: String) {
  issues(first: 100, after: $after, filter: { project: { name: { eq: $project } } }) {
    pageInfo { hasNextPage endCursor }
    nodes {
      identifier
      state { name }
      relations(first: 50) { nodes { type relatedIssue { identifier } } }
    }
  }
}
"""


def key_path():
    """$SMELT_LINEAR_KEY_FILE, or .linear-api-key at the root of the main
    checkout (gitignored). The main checkout, not this worktree's: one key
    serves every worktree, and it lives in the repo's directory, which a
    reboot keeps (the home directory isn't kept)."""
    if "SMELT_LINEAR_KEY_FILE" in os.environ:
        return os.environ["SMELT_LINEAR_KEY_FILE"]
    here = os.path.dirname(os.path.abspath(__file__))
    common = subprocess.run(
        ["git", "-C", here, "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True,
    ).stdout.strip()
    root = os.path.dirname(common) if common else os.path.dirname(here)
    return os.path.join(root, ".linear-api-key")


def state_path():
    base = os.environ.get(
        "SMELT_PM_STATE_DIR", os.path.expanduser("~/.local/state/smelt")
    )
    slug = "".join(c if c.isalnum() else "-" for c in PROJECT.lower())
    slug = "-".join(part for part in slug.split("-") if part)
    return os.path.join(base, f"pm-board-snapshot-{slug}.json")


def fail(msg):
    print(f"pm-wait-for-board: {msg}", file=sys.stderr)
    sys.exit(2)


def read_key():
    path = key_path()
    try:
        st = os.stat(path)
    except FileNotFoundError:
        fail(
            f"no Linear API key at {path}. Create a personal API key "
            "(Linear > Settings > Security & access > API keys; read-only is enough), "
            f"put it in that file, and chmod 600 it."
        )
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        fail(f"{path} is readable by others; run chmod 600 {path}")
    with open(path) as f:
        key = f.read().strip()
    if not key:
        fail(f"{path} is empty")
    return key


def fetch_board(key):
    """{identifier: {"state": name, "blocks": [identifier, ...]}} for the project."""
    board, after = {}, None
    while True:
        body = json.dumps(
            {"query": QUERY, "variables": {"project": PROJECT, "after": after}}
        ).encode()
        req = urllib.request.Request(
            API_URL,
            data=body,
            headers={"Content-Type": "application/json", "Authorization": key},
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.load(resp)
        if data.get("errors"):
            raise RuntimeError(
                "Linear API error: " + "; ".join(e.get("message", "?") for e in data["errors"])
            )
        issues = data["data"]["issues"]
        for node in issues["nodes"]:
            board[node["identifier"]] = {
                "state": node["state"]["name"],
                "blocks": sorted(
                    r["relatedIssue"]["identifier"]
                    for r in node["relations"]["nodes"]
                    if r["type"] == "blocks" and r.get("relatedIssue")
                ),
            }
        if not issues["pageInfo"]["hasNextPage"]:
            return board
        after = issues["pageInfo"]["endCursor"]


def changes(old, new):
    """Lines describing the changes in `new` that need the Project Manager."""
    out = []
    for ident in sorted(new, key=lambda i: (i.split("-")[0], int(i.split("-")[-1]))):
        now = new[ident]["state"]
        before = old.get(ident, {}).get("state")
        if now == before:
            continue
        if now in WAKE_STATES:
            out.append(f"{ident}: {before or 'new'} -> {now}")
        elif now == DONE:
            waiting = [
                b for b in new[ident]["blocks"] if b in new and new[b]["state"] != DONE
            ]
            if waiting:
                out.append(
                    f"{ident}: {before or 'new'} -> Done, unblocking {', '.join(waiting)}"
                )
    return out


def load_snapshot():
    """The saved board, or None when there's none to compare with. A snapshot
    that can't be used (corrupt, not a board, unreadable) is said on stderr,
    and the first poll then takes a new baseline (SME-176 review 1)."""
    path = state_path()
    try:
        with open(path) as f:
            board = json.load(f)
        if not isinstance(board, dict) or not all(
            isinstance(v, dict) and "state" in v for v in board.values()
        ):
            raise ValueError("not a board")
        return board
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        print(f"pm-wait-for-board: the snapshot at {path} can't be used ({e})", file=sys.stderr)
        return None


def save_snapshot(board):
    # A temporary file of this save's own: two waiters can run at once, and
    # with a shared one each truncated and moved the other's (SME-176 review
    # 1). The last move wins, and the file in place is always a whole board.
    path = state_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(
        dir=os.path.dirname(path), prefix=os.path.basename(path) + ".", suffix=".tmp"
    )
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(board, f, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def _save_or_fail(board):
    # An unsaved snapshot is SME-176's missed wake again at the next restart,
    # and a state directory that can't be written is a setup problem the
    # Project Manager should see.
    try:
        save_snapshot(board)
    except OSError as e:
        fail(f"can't save the board snapshot at {state_path()}: {e}")


def self_test():
    def b(**states):
        return {k.replace("_", "-"): {"state": v, "blocks": []} for k, v in states.items()}

    cases = []
    # No change: nothing.
    cases.append((b(SME_1="Backlog"), b(SME_1="Backlog"), []))
    # Into each wake state.
    for s in WAKE_STATES:
        cases.append((b(SME_1="Backlog"), b(SME_1=s), [f"SME-1: Backlog -> {s}"]))
    # A new ticket created straight into Todo.
    cases.append(({}, b(SME_2="Todo"), ["SME-2: new -> Todo"]))
    # Out of a wake state, or into a non-wake state: nothing.
    cases.append((b(SME_1="Todo"), b(SME_1="In Progress"), []))
    cases.append((b(SME_1="Up Next"), b(SME_1="Planned"), []))
    # Done with nothing waiting: nothing.
    cases.append((b(SME_1="Approved"), b(SME_1="Done"), []))
    # Done while blocking an open ticket: wake, naming it.
    old = b(SME_1="Approved", SME_2="Up Next", SME_3="Done")
    new = b(SME_1="Done", SME_2="Up Next", SME_3="Done")
    new["SME-1"]["blocks"] = ["SME-2", "SME-3"]
    cases.append((old, new, ["SME-1: Approved -> Done, unblocking SME-2"]))
    # Several changes, in ticket order.
    cases.append(
        (b(SME_10="Backlog", SME_9="Planned"), b(SME_10="Up Next", SME_9="Todo"),
         ["SME-9: Planned -> Todo", "SME-10: Backlog -> Up Next"])
    )
    failed = 0
    for i, (old, new, want) in enumerate(cases):
        got = changes(old, new)
        if got != want:
            failed += 1
            print(f"case {i}: want {want}, got {got}")
    passed = len(cases) - failed

    # The poll loop, driven with scripted polls in a state directory of the
    # test's own: it never reads the real snapshot or the key.
    global PROJECT
    PROJECT = "Self test"
    saved_dir = os.environ.get("SMELT_PM_STATE_DIR")
    try:
        with tempfile.TemporaryDirectory(prefix="pm-wait-for-board-self-test.") as root:
            for name, case in _loop_cases(b):
                case_dir = tempfile.mkdtemp(dir=root)
                os.environ["SMELT_PM_STATE_DIR"] = case_dir
                try:
                    problems = case()
                except Exception as e:  # noqa: BLE001 - reported as the case's failure
                    problems = [f"raised {e!r}"]
                finally:
                    os.chmod(case_dir, 0o700)
                if problems:
                    failed += 1
                    for p in problems:
                        print(f"{name}: {p}")
                else:
                    passed += 1
    finally:
        if saved_dir is None:
            os.environ.pop("SMELT_PM_STATE_DIR", None)
        else:
            os.environ["SMELT_PM_STATE_DIR"] = saved_dir
    print(f"{passed} passed, {failed} failed")
    return 1 if failed else 0


class _Stop(Exception):
    """The scripted polls ran out: stands for the waiter being killed."""


def _run(polls, once=False):
    """One run of the script, as main() makes it, against scripted polls: each
    is a board, an exception the fetch raises, or a function called at that
    poll that returns one of those. Returns (status, stdout lines, stderr); the
    status is "killed" when the polls ran out first."""
    polls = list(polls)

    def fetch():
        if not polls:
            raise _Stop()
        p = polls.pop(0)
        if callable(p):
            p = p()
        if isinstance(p, BaseException):
            raise p
        return p

    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            status = watch(fetch, lambda s: None, load_snapshot(), once, 60)
        except _Stop:
            status = "killed"
        except SystemExit as e:
            status = e.code
        except Exception as e:  # noqa: BLE001 - a case reports it as its result
            status = f"raised {e!r}"
    return status, out.getvalue().splitlines(), err.getvalue()


def _expect(problems, what, got, want):
    if got != want:
        problems.append(f"{what}: want {want!r}, got {got!r}")


def _loop_cases(b):
    def first_run_takes_a_baseline():
        p = []
        status, out, _ = _run([b(SME_1="Up Next")], once=True)
        _expect(p, "status", status, 1)
        _expect(p, "stdout", out, [])
        _expect(p, "snapshot", load_snapshot(), b(SME_1="Up Next"))
        return p

    def a_move_into_a_wake_state_wakes():
        p = []
        save_snapshot(b(SME_1="Backlog"))
        status, out, _ = _run([b(SME_1="Backlog"), b(SME_1="Up Next")])
        _expect(p, "status", status, 0)
        _expect(p, "stdout", out, ["SME-1: Backlog -> Up Next"])
        _expect(p, "snapshot", load_snapshot(), b(SME_1="Up Next"))
        return p

    def failed_polls_give_up_after_the_limit():
        p = []
        save_snapshot(b(SME_1="Backlog"))
        polls = [urllib.error.URLError("down")] * MAX_FAILURES + [b(SME_1="Up Next")]
        status, out, _ = _run(polls)
        _expect(p, "status", status, 2)
        _expect(p, "stdout", out, [])
        return p

    def a_refused_key_exits_at_once():
        p = []
        save_snapshot(b(SME_1="Backlog"))
        refused = urllib.error.HTTPError(API_URL, 401, "Unauthorized", {}, None)
        status, _, err = _run([refused, b(SME_1="Up Next")])
        _expect(p, "status", status, 2)
        _expect(p, "says the key was refused", "refused the key" in err, True)
        return p

    # SME-176: every successful poll becomes the board the next one is
    # compared with, in memory and in the snapshot file.
    def out_and_back_within_one_run_wakes():
        p = []
        save_snapshot(b(SME_1="Up Next"))
        status, out, _ = _run([b(SME_1="Planned"), b(SME_1="Up Next")])
        _expect(p, "status", status, 0)
        _expect(p, "stdout", out, ["SME-1: Planned -> Up Next"])
        return p

    def out_and_back_across_a_restart_wakes():
        p = []
        save_snapshot(b(SME_1="Up Next"))
        status, out, _ = _run([b(SME_1="Planned")])
        _expect(p, "run 1 status", status, "killed")
        _expect(p, "run 1 snapshot", load_snapshot(), b(SME_1="Planned"))
        status, out, _ = _run([b(SME_1="Up Next")])
        _expect(p, "run 2 status", status, 0)
        _expect(p, "run 2 stdout", out, ["SME-1: Planned -> Up Next"])
        return p

    def a_failed_poll_changes_nothing():
        p = []
        save_snapshot(b(SME_1="Up Next"))
        seen = []

        def fails_and_reads_the_snapshot():
            seen.append(load_snapshot())
            return urllib.error.URLError("down")

        status, out, _ = _run([b(SME_1="Planned"), fails_and_reads_the_snapshot, b(SME_1="Up Next")])
        _expect(p, "status", status, 0)
        _expect(p, "stdout", out, ["SME-1: Planned -> Up Next"])
        _expect(p, "snapshot at the failure", seen, [b(SME_1="Planned")])
        return p

    def a_move_between_runs_wakes_once():
        p = []
        save_snapshot(b(SME_1="Backlog", SME_2="Backlog"))
        status, out, _ = _run([b(SME_1="Up Next", SME_2="Backlog")])
        _expect(p, "run 1 status", status, 0)
        # The Project Manager's own pass moves SME-2 while no waiter runs.
        status, out, _ = _run([b(SME_1="Up Next", SME_2="Up Next")])
        _expect(p, "run 2 status", status, 0)
        _expect(p, "run 2 stdout", out, ["SME-2: Backlog -> Up Next"])
        status, out, _ = _run([b(SME_1="Up Next", SME_2="Up Next")] * 3)
        _expect(p, "run 3 status", status, "killed")
        _expect(p, "run 3 stdout", out, [])
        return p

    def once_with_nothing_changed_saves_the_board():
        p = []
        save_snapshot(b(SME_1="Up Next"))
        status, out, _ = _run([b(SME_1="Planned")], once=True)
        _expect(p, "first --once status", status, 1)
        _expect(p, "snapshot", load_snapshot(), b(SME_1="Planned"))
        status, out, _ = _run([b(SME_1="Up Next")], once=True)
        _expect(p, "second --once status", status, 0)
        _expect(p, "second --once stdout", out, ["SME-1: Planned -> Up Next"])
        return p

    def limit_out_and_back_between_two_polls_is_missed():
        # The documented limit: no poll saw it leave, so no poll can see it
        # come back.
        p = []
        save_snapshot(b(SME_1="Up Next"))
        status, out, _ = _run([b(SME_1="Up Next")])
        _expect(p, "status", status, "killed")
        _expect(p, "stdout", out, [])
        return p

    def leaving_the_board_and_coming_back_wakes():
        p = []
        save_snapshot(b(SME_1="Up Next", SME_2="Backlog"))
        status, out, _ = _run([b(SME_2="Backlog"), b(SME_1="Up Next", SME_2="Backlog")])
        _expect(p, "status", status, 0)
        _expect(p, "stdout", out, ["SME-1: new -> Up Next"])
        return p

    def a_bad_snapshot_is_named_and_replaced():
        # Corrupt, not a board, or unreadable: said on stderr, then a new
        # baseline, never a traceback or a silent one.
        p = []
        for what, write in (
            ("corrupt", lambda f: f.write('{"SME-1": {"state": "Up')),
            ("not a board", lambda f: f.write("[]")),
            ("unreadable", lambda f: (f.write("{}"), os.chmod(state_path(), 0))),
        ):
            os.makedirs(os.path.dirname(state_path()), exist_ok=True)
            with open(state_path(), "w") as f:
                write(f)
            status, out, err = _run([b(SME_1="Up Next")], once=True)
            _expect(p, f"{what}: status", status, 1)
            _expect(p, f"{what}: says so", f"the snapshot at {state_path()} can't be used" in err, True)
            _expect(p, f"{what}: new baseline", load_snapshot(), b(SME_1="Up Next"))
        return p

    def make_saves_fail():
        # A state directory nothing can be written in. self_test makes it
        # writable again after the case.
        os.makedirs(os.path.dirname(state_path()), exist_ok=True)
        os.chmod(os.path.dirname(state_path()), 0o500)

    def a_second_waiters_save_mid_write_breaks_neither():
        # Two waiters can run at once (the ticket's Trade-offs). Forced
        # interleaving: waiter B saves a whole snapshot while waiter A is
        # between opening its temporary file and moving it into place. With
        # one shared temporary file, B's save truncated and moved A's, so A's
        # write landed in the live snapshot (corrupt when shorter) and A's
        # move failed: exit 2.
        p = []
        save_snapshot(b(SME_1="Up Next", SME_22="Backlog", SME_333="Backlog"))
        real_dump = json.dump
        other = b(SME_1="Planned", SME_22="Backlog", SME_333="Backlog")

        def dump_with_b_saving_first(obj, f, **kw):
            json.dump = real_dump
            save_snapshot(other)
            real_dump(obj, f, **kw)

        json.dump = dump_with_b_saving_first
        try:
            status, out, err = _run([b(SME_1="Planned")], once=True)
        finally:
            json.dump = real_dump
        _expect(p, "A's status", status, 1)
        _expect(p, "A's stderr", err, "")
        _expect(p, "snapshot (A moved last)", load_snapshot(), b(SME_1="Planned"))
        leftovers = sorted(set(os.listdir(os.path.dirname(state_path()))) - {os.path.basename(state_path())})
        _expect(p, "temporary files left", leftovers, [])
        return p

    def a_wake_whose_save_fails_still_reports_the_change():
        # Printed before the save: a kill or a failure between the two can
        # repeat a wake at the next run, never lose one.
        p = []
        save_snapshot(b(SME_1="Backlog"))
        make_saves_fail()
        status, out, err = _run([b(SME_1="Up Next")])
        _expect(p, "status", status, 2)
        _expect(p, "stdout", out, ["SME-1: Backlog -> Up Next"])
        _expect(p, "says why", "can't save the board snapshot at " + state_path() in err, True)
        return p

    def a_failed_save_with_nothing_to_report_exits_2():
        p = []
        save_snapshot(b(SME_1="Up Next"))
        make_saves_fail()
        status, out, err = _run([b(SME_1="Planned"), b(SME_1="Up Next")])
        _expect(p, "status", status, 2)
        _expect(p, "stdout", out, [])
        _expect(p, "says why", "can't save the board snapshot at " + state_path() in err, True)
        return p

    def a_failed_baseline_save_exits_2():
        p = []
        make_saves_fail()
        status, out, err = _run([b(SME_1="Up Next")])
        _expect(p, "status", status, 2)
        _expect(p, "says why", "can't save the board snapshot at " + state_path() in err, True)
        return p

    # Each project the Project Manager is directed to has a snapshot of its
    # own, so switching projects can't report the other project's tickets as
    # new.
    def each_project_has_its_own_snapshot():
        global PROJECT
        p = []
        saved = PROJECT
        try:
            PROJECT = "Bug bash 4"
            save_snapshot(b(SME_1="Up Next"))
            bash_path = state_path()
            PROJECT = "Maintenance"
            _expect(p, "other project's snapshot", load_snapshot(), None)
            _expect(p, "paths differ", state_path() != bash_path, True)
            _expect(p, "file name", os.path.basename(bash_path), "pm-board-snapshot-bug-bash-4.json")
            PROJECT = "Bug bash 4"
            _expect(p, "own snapshot", load_snapshot(), b(SME_1="Up Next"))
        finally:
            PROJECT = saved
        return p

    return [
        (f.__name__, f)
        for f in (
            each_project_has_its_own_snapshot,
            a_bad_snapshot_is_named_and_replaced,
            a_second_waiters_save_mid_write_breaks_neither,
            a_wake_whose_save_fails_still_reports_the_change,
            a_failed_save_with_nothing_to_report_exits_2,
            a_failed_baseline_save_exits_2,
            first_run_takes_a_baseline,
            a_move_into_a_wake_state_wakes,
            failed_polls_give_up_after_the_limit,
            a_refused_key_exits_at_once,
            out_and_back_within_one_run_wakes,
            out_and_back_across_a_restart_wakes,
            a_failed_poll_changes_nothing,
            a_move_between_runs_wakes_once,
            once_with_nothing_changed_saves_the_board,
            limit_out_and_back_between_two_polls_is_missed,
            leaving_the_board_and_coming_back_wakes,
        )
    ]


def main():
    global PROJECT
    p = argparse.ArgumentParser(
        description="Wait until a Linear project's tickets need the Project Manager."
    )
    p.add_argument("--project", help='the Linear project the Project Manager is directed to, by name (e.g. "Bug bash 4")')
    p.add_argument("--interval", type=int, default=60, help="seconds between polls (default 60)")
    p.add_argument("--once", action="store_true", help="check once and exit (1 if nothing changed)")
    p.add_argument("--self-test", action="store_true", help="run the comparison's and poll loop's tests and exit")
    args = p.parse_args()
    if args.self_test:
        return self_test()
    if not args.project or not args.project.strip():
        p.error("--project is required: the project the Project Manager is directed to")
    PROJECT = args.project.strip()
    if args.interval < 10:
        p.error("--interval must be at least 10 seconds")

    key = read_key()
    return watch(lambda: fetch_board(key), time.sleep, load_snapshot(), args.once, args.interval)


def watch(fetch, sleep, old, once, interval):
    """Poll `fetch()` until the board changes in a way that needs the Project
    Manager, comparing with `old` (None: no snapshot yet). Returns the exit
    status. `fetch` returns a board or raises what fetch_board raises; `sleep`
    waits that many seconds."""
    failures = 0
    while True:
        try:
            board = fetch()
            failures = 0
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                fail(
                    f"Linear refused the key in {key_path()} (HTTP {e.code}). It should be a "
                    "personal API key, which starts with lin_api_ (Linear > Settings > "
                    "Security & access > API keys)."
                )
            failures += 1
            if once or failures >= MAX_FAILURES:
                print(f"pm-wait-for-board: giving up after {failures} failed polls: {e}", file=sys.stderr)
                return 2
            print(f"pm-wait-for-board: poll failed ({e}); retrying", file=sys.stderr)
            sleep(min(interval * failures, 600))
            continue
        except (urllib.error.URLError, OSError, RuntimeError, KeyError, ValueError) as e:
            failures += 1
            if once or failures >= MAX_FAILURES:
                print(f"pm-wait-for-board: giving up after {failures} failed polls: {e}", file=sys.stderr)
                return 2
            print(f"pm-wait-for-board: poll failed ({e}); retrying", file=sys.stderr)
            sleep(min(interval * failures, 600))
            continue
        if old is None:
            # First run: nothing to compare with yet. Keep this as the baseline.
            _save_or_fail(board)
            print("pm-wait-for-board: no snapshot yet; took one, watching from now", file=sys.stderr)
        else:
            found = changes(old, board)
            if found:
                # Printed before the save: a kill between the two then
                # repeats this wake at the next run instead of losing it.
                print("\n".join(found), flush=True)
                _save_or_fail(board)
                return 0
            # Nothing to report: this poll is what the next one, or the next
            # run, compares with (SME-176). Otherwise a ticket that leaves a
            # wake state and comes back looks unchanged.
            _save_or_fail(board)
        old = board
        if once:
            return 1
        sleep(interval)


if __name__ == "__main__":
    sys.exit(main())
