#!/usr/bin/env bash
# scripts/check-server's port lock and its port's listeners (SME-100,
# SME-175, SME-186): the lock held by the running server's process group and
# freed by stop or by the group dying; a second start on the same port
# waiting for it, naming the first's worktree, while refusals never wait;
# and that a port something else listens on is refused before anything is
# checked out, created or started — including a listener that appears
# mid-start, answers 500, sits beside the server's on another family, or
# answers through http_proxy, and that the readiness wait counts an answer
# only while every listener on the port is the server's own. These sections
# moved unchanged from scripts/test-check-server, which had reached the size
# ceiling (SME-265). The stubs and helpers are in
# scripts/lib/test-check-scripts.sh.
#
#   scripts/test-check-server-ports
. "$(dirname "$0")/lib/test-check-scripts.sh"

# Whatever an earlier, failed run left running.
check_server stop >/dev/null

# The first commit of this repo: before SME-115's fix, so check-server must
# refuse to serve it (test-check-server defines the same).
old_ref=$(git rev-list --max-parents=0 HEAD | tail -n 1)

# 11. The port lock: held by the running server's process group, freed by
# stop or by the group dying; a second start on the same port waits for it,
# naming the first's worktree; refusals never wait.
port_lock=$SMELT_LOCK_DIR/smelt-check-server-$port.lock
port_is_free() { flock -n "$port_lock" true; }
worktree2=$dir/worktree2
[ -d "$worktree2/.git" ] || git clone -q --shared --no-checkout "$PWD" "$worktree2" || exit 1
"${cs_env[@]}" CHECK_WORKTREE="$worktree2" scripts/check-server stop >/dev/null 2>&1
check_server start HEAD >/dev/null || fail "start for the port lock"
pgid=$(cat "$pid_file" 2>/dev/null)
port_is_free && fail "check-server: the port lock is free while the server runs"
check_server stop >/dev/null
port_is_free || fail "check-server: the port lock is still held after stop"
check_server start HEAD >/dev/null || fail "start for the port lock, to kill"
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && kill -KILL -- "-$pgid"
sleep 0.5
port_is_free || fail "check-server: the port lock is still held after its server was killed"
check_server stop >/dev/null
check_server start HEAD >/dev/null || fail "start before a second one on the same port"
out=$(timeout 3 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 124 ] || fail "check-server: a second start on the same port didn't wait (exit $rc): $out"
grep -qF "waiting for port $port: a check server from $worktree holds it" <<<"$out" ||
    fail "check-server: the second start's waiting line: $out"
[ -s "$worktree2/.check-server.pid" ] && fail "check-server: a waiting start wrote its pid file"
other_port=$(free_port) || fail "no second free port"
if ! out=$(timeout 20 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_PORT="$other_port" scripts/check-server start HEAD 2>&1); then
    fail "check-server: a start on another port while one runs: $out"
fi
"${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_PORT="$other_port" scripts/check-server stop >/dev/null 2>&1
# Refused starts exit at once, even while the port is held.
out=$(timeout 5 "${cs_env[@]}" CHECK_WORKTREE="$worktree" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "check-server: an 'already running' start exited $rc: $out"
out=$(timeout 5 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_SCRATCH_DB=1 scripts/check-server start "$old_ref" 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "check-server: SME-115's refusal exited $rc while the port was held: $out"
check_server stop >/dev/null

# SME-175: listeners that aren't the check server's. Each is a python HTTP
# server answering 200, in a process group of its own, which this script
# starts and stops by the pid it recorded, and only those.
foreign_ready=$dir/foreign-ready
# Starts one on HOST:PORT and waits until it listens; sets foreign_pid,
# checked to be the server itself (its own pid, written once it listens).
# Fails when it can't bind.
start_foreign() { # host port [http-200.py options]
    : >"$foreign_ready"
    "$STUB_PYTHON3" -I "$STUB_HTTP_200" "$@" --own-group --ready "$foreign_ready" </dev/null >/dev/null 2>&1 &
    foreign_pid=$!
    for _ in $(seq 1 50); do
        if [ -s "$foreign_ready" ]; then
            [ "$(cat "$foreign_ready")" = "$foreign_pid" ] && return 0
            fail "the foreign listener's pid is $(cat "$foreign_ready"), not $foreign_pid"
            return 1
        fi
        pid_is_live "$foreign_pid" || return 1
        sleep 0.1
    done
    return 1
}
stop_foreign() { # pid
    kill "$1" 2>/dev/null
    wait "$1" 2>/dev/null
}
# Whether IPv6's loopback can be bound here (a container may have no IPv6).
has_ipv6_loopback() {
    "$STUB_PYTHON3" -I -c 'import socket; s = socket.socket(socket.AF_INET6); s.bind(("::1", 0))' 2>/dev/null
}

# 12. A port something else already listens on is refused before anything
# is checked out, created or started: no sqlx or cleanup call, no state
# file written, the check worktree where it was, the port lock freed. The
# refusal names the listener, which is never signalled, by start or by a
# stop after it.
expect_refused_port() { # host
    local host=$1 fport out rc head_before
    fport=$(free_port) || { fail "no free port for $host"; return; }
    if ! start_foreign "$host" "$fport"; then
        fail "the foreign listener on [$host]:$fport never listened"
        return
    fi
    head_before=$(git -C "$worktree" rev-parse HEAD)
    : >"$SQLX_CALLS"
    : >"$CLEANUP_CALLS"
    : >"$pid_file"
    : >"$scratch_file"
    out=$(timeout 10 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" CHECK_SCRATCH_DB=1 \
        scripts/check-server start HEAD~1 2>&1)
    rc=$?
    [ "$rc" = 1 ] || fail "[$host]: start on a port another process listens on exited $rc: $out"
    grep -q "check server up" <<<"$out" && fail "[$host]: start on a taken port said it was up: $out"
    grep -qw "pid $foreign_pid" <<<"$out" || fail "[$host]: the refusal doesn't name the listener's pid $foreign_pid: $out"
    grep -q "CHECK_PORT" <<<"$out" || fail "[$host]: the refusal doesn't say to use another CHECK_PORT: $out"
    [ -s "$SQLX_CALLS" ] && fail "[$host]: a refused start called sqlx: $(cat "$SQLX_CALLS")"
    [ -s "$CLEANUP_CALLS" ] && fail "[$host]: a refused start ran the cleanup: $(cat "$CLEANUP_CALLS")"
    [ -s "$pid_file" ] && fail "[$host]: a refused start wrote a pid file: '$(cat "$pid_file")'"
    [ -s "$scratch_file" ] && fail "[$host]: a refused start wrote a scratch file: '$(cat "$scratch_file")'"
    [ "$(git -C "$worktree" rev-parse HEAD)" = "$head_before" ] || fail "[$host]: a refused start checked out another commit"
    flock -n "$SMELT_LOCK_DIR/smelt-check-server-$fport.lock" true || fail "[$host]: a refused start left its port lock held"
    pid_is_live "$foreign_pid" || fail "[$host]: start signalled the listener it refused"
    "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
    pid_is_live "$foreign_pid" || fail "[$host]: stop signalled a listener it didn't start"
    stop_foreign "$foreign_pid"
}
expect_refused_port 127.0.0.1
# 12b. The refusal names the listener by its program name, never its
# arguments (review 1): a hand-run process can carry a secret there
# (`postgres://user:pass@…`, `--token=…`), and the refusal lands in the
# session's output and logs.
fport=$(free_port)
if start_foreign 127.0.0.1 "$fport" "--token=sme175-not-a-real-secret"; then
    out=$(timeout 10 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server start HEAD 2>&1)
    grep -q "sme175-not-a-real-secret" <<<"$out" && fail "the refusal prints the listener's arguments: $out"
    grep -qF "pid $foreign_pid (python3)" <<<"$out" || fail "the refusal doesn't name the listener's program: $out"
    stop_foreign "$foreign_pid"
else
    fail "the listener with an argument never listened"
fi

# 12c. A CHECK_PORT that isn't a plain decimal port is refused at once
# (review 2): `048811` read as octal made both port checks look at port 0
# and the lock file name another port than dx's.
for bad in "0$port" abc 0 70000 "$port "; do
    : >"$SQLX_CALLS"
    : >"$pid_file"
    out=$(timeout 10 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$bad" CHECK_SCRATCH_DB=1 scripts/check-server start HEAD 2>&1)
    rc=$?
    [ "$rc" = 2 ] || fail "CHECK_PORT='$bad': start exited $rc: $out"
    grep -qF "CHECK_PORT" <<<"$out" || fail "CHECK_PORT='$bad': the refusal doesn't name CHECK_PORT: $out"
    [ -s "$SQLX_CALLS" ] && fail "CHECK_PORT='$bad': start called sqlx: $(cat "$SQLX_CALLS")"
    [ -s "$pid_file" ] && fail "CHECK_PORT='$bad': start wrote a pid file"
    "${cs_env[@]}" CHECK_WORKTREE="$worktree" scripts/check-server stop >/dev/null 2>&1
done

# 12d. A CHECK_DEV_DB=1 start refused by a port something else listens on
# says nothing about the dev database either (SME-226 review 1, finding 3):
# the port is refused before anything is checked out, created or started, so
# the notice belongs after it and not before.
fport=$(free_port)
if start_foreign 127.0.0.1 "$fport"; then
    : >"$SQLX_CALLS"
    : >"$pid_file"
    extra_env=(CHECK_DEV_DB=1 CHECK_PORT="$fport")
    out=$(check_server start HEAD)
    rc=$?
    extra_env=()
    [ "$rc" = 1 ] || fail "a CHECK_DEV_DB=1 start on a taken port exited $rc, not 1: $out"
    grep -qw "pid $foreign_pid" <<<"$out" || fail "12d: the refusal doesn't name the listener's pid $foreign_pid: $out"
    grep -qF "serving the DEV database" <<<"$out" &&
        fail "12d: a start refused for its port said it serves the DEV database: $out"
    [ -s "$SQLX_CALLS" ] && fail "12d: the refused start called sqlx: $(cat "$SQLX_CALLS")"
    stop_foreign "$foreign_pid"
else
    fail "12d: the foreign listener never listened"
fi

# 13. The same for a listener on IPv6's loopback only, which curl tries
# first for localhost and which dx's IPv4 bind doesn't collide with.
if has_ipv6_loopback; then
    expect_refused_port ::1
else
    echo "note: ::1 can't be bound here; skipping the IPv6-only listener case"
fi

# The readiness wait counts an answer only while every listener on the port
# is the server's own (SME-175). Each case below starts check-server in the
# background on a port of its own, with dx shaped by the given settings,
# and puts a foreign listener on the port once the start is past its
# preflight (its pid file is written just after).
start_out=$dir/start-out
start_in_background() { # port, then VAR=VALUE settings
    local p=$1
    shift
    : >"$start_out"
    : >"$pid_file"
    timeout 30 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$p" "$@" \
        scripts/check-server start HEAD >"$start_out" 2>&1 &
    starter=$!
}
wait_for_pid_file() {
    for _ in $(seq 1 100); do
        [ -s "$pid_file" ] && return 0
        sleep 0.1
    done
    return 1
}
# Waits up to 10 s for process group $1 to end.
wait_for_group_end() { # pgid
    for _ in $(seq 1 100); do
        group_is_live "$1" || return 0
        sleep 0.1
    done
    return 1
}

# 14. A listener appears on the port after the preflight, while dx is still
# building (it binds 3 s in): start stops waiting and exits 1, naming it,
# and dx then fails its own bind and exits.
fport=$(free_port)
start_in_background "$fport" DX_BIND_DELAY=3
wait_for_pid_file || fail "the mid-start case's start wrote no pid file: $(cat "$start_out")"
dx_group=$(cat "$pid_file")
start_foreign 0.0.0.0 "$fport" || fail "the mid-start foreign listener never listened"
wait "$starter"
rc=$?
out=$(cat "$start_out")
[ "$rc" = 1 ] || fail "a listener appearing mid-start: start exited $rc: $out"
grep -q "check server up" <<<"$out" && fail "a listener appearing mid-start passed for the check server: $out"
grep -qw "pid $foreign_pid" <<<"$out" || fail "a listener appearing mid-start isn't named (pid $foreign_pid): $out"
wait_for_group_end "$dx_group" || fail "the stub dx kept running after its port was taken"
"${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
pid_is_live "$foreign_pid" || fail "start or stop signalled the mid-start listener"
stop_foreign "$foreign_pid"

# 15. The same while dx never binds at all: start exits 1 within seconds,
# rather than taking the foreign answer for dx's or waiting 12 minutes.
fport=$(free_port)
start_in_background "$fport" DX_NO_LISTEN=1
wait_for_pid_file || fail "the never-binds case's start wrote no pid file: $(cat "$start_out")"
start_foreign 0.0.0.0 "$fport" || fail "the never-binds foreign listener never listened"
wait "$starter"
rc=$?
out=$(cat "$start_out")
[ "$rc" = 1 ] || fail "a listener while dx never binds: start exited $rc: $out"
grep -q "check server up" <<<"$out" && fail "a listener while dx never binds passed for the check server: $out"
grep -qw "pid $foreign_pid" <<<"$out" || fail "a listener while dx never binds isn't named (pid $foreign_pid): $out"
"${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
pid_is_live "$foreign_pid" || fail "start or stop signalled the never-binds listener"
stop_foreign "$foreign_pid"

# 15b. The same for a listener that answers 500, as a server still building
# does (review 1): no answer of its would pass, so only the check before
# the request ends the start; without it, start would wait 12 minutes.
fport=$(free_port)
start_in_background "$fport" DX_NO_LISTEN=1
wait_for_pid_file || fail "the 500 case's start wrote no pid file: $(cat "$start_out")"
start_foreign 0.0.0.0 "$fport" --status 500 || fail "the 500 foreign listener never listened"
wait "$starter"
rc=$?
out=$(cat "$start_out")
[ "$rc" = 1 ] || fail "a listener answering 500 while dx never binds: start exited $rc (124: it waited): $out"
grep -qw "pid $foreign_pid" <<<"$out" || fail "a listener answering 500 isn't named (pid $foreign_pid): $out"
"${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
pid_is_live "$foreign_pid" || fail "start or stop signalled the listener answering 500"
stop_foreign "$foreign_pid"

# 16. A listener beside the server's, on IPv6's loopback (dx binds IPv4
# only), appearing between start's ownership check and its request (the
# curl stub's hook starts it): start exits 1 rather than up, whichever of
# the two answered.
if has_ipv6_loopback; then
    fport=$(free_port)
    hook=$dir/curl-hook
    hook_done=$dir/curl-hook-done
    hook_ready=$dir/curl-hook-ready
    hook_pid=$dir/curl-hook-pid
    cat >"$hook" <<'EOF'
#!/usr/bin/env bash
# Once: a foreign listener on [::1]:$HOOK_PORT (it closes the locks start
# holds), its pid recorded at once so the test can always stop it.
[ -s "$HOOK_DONE" ] && exit 0
echo 1 >"$HOOK_DONE"
"$STUB_PYTHON3" -I "$STUB_HTTP_200" ::1 "$HOOK_PORT" --own-group --ready "$HOOK_READY" </dev/null >/dev/null 2>&1 &
echo $! >"$HOOK_PID"
for _ in $(seq 1 50); do
    [ -s "$HOOK_READY" ] && exit 0
    sleep 0.1
done
EOF
    chmod +x "$hook"
    : >"$hook_done"
    : >"$hook_ready"
    : >"$hook_pid"
    start_in_background "$fport" CURL_HOOK="$hook" HOOK_DONE="$hook_done" HOOK_READY="$hook_ready" HOOK_PID="$hook_pid" HOOK_PORT="$fport"
    wait "$starter"
    rc=$?
    out=$(cat "$start_out")
    foreign_pid=$(cat "$hook_ready")
    [ -n "$foreign_pid" ] || fail "the curl hook's listener never listened: $out"
    [ "$rc" = 1 ] || fail "a listener beside the server's: start exited $rc: $out"
    grep -q "check server up" <<<"$out" && fail "a listener beside the server's let start say up: $out"
    [ -n "$foreign_pid" ] && { grep -qw "pid $foreign_pid" <<<"$out" || fail "the listener beside the server's isn't named (pid $foreign_pid): $out"; }
    "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
    if [ -n "$foreign_pid" ]; then
        pid_is_live "$foreign_pid" || fail "start or stop signalled the listener beside the server's"
    fi
    # By the pid the hook recorded at once, so even one that never got
    # ready is stopped.
    [ -s "$hook_pid" ] && kill "$(cat "$hook_pid")" 2>/dev/null
else
    echo "note: ::1 can't be bound here; skipping the listener-beside case"
fi

# 17. Nothing listens until dx binds, 3 s in: start waits and then says up,
# through the real curl.
fport=$(free_port)
if ! out=$(timeout 30 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" DX_BIND_DELAY=3 scripts/check-server start HEAD 2>&1); then
    fail "a dx that binds late: start failed: $out"
fi
grep -qF "check server up at http://localhost:$fport/" <<<"$out" || fail "a dx that binds late: start said: $out"
"${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1

# 17b. A proxy in the environment never answers for the server (review 1):
# curl sends even localhost through http_proxy, so a 200 from the proxy
# passed while dx, its own listener alone on the port, still answered 500.
fport=$(free_port)
proxy_port=$(free_port)
if start_foreign 127.0.0.1 "$proxy_port"; then
    out=$(timeout 5 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" DX_STATUS=500 \
        http_proxy="http://127.0.0.1:$proxy_port" HTTP_PROXY="http://127.0.0.1:$proxy_port" no_proxy= NO_PROXY= \
        scripts/check-server start HEAD 2>&1)
    rc=$?
    [ "$rc" = 124 ] || fail "a 200 from http_proxy: start exited $rc rather than waiting for dx's 2xx: $out"
    grep -q "check server up" <<<"$out" && fail "a 200 from http_proxy passed for the check server: $out"
    "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1
    stop_foreign "$foreign_pid"
else
    fail "the proxy listener never listened"
fi

# 18. dx binds between the ownership check's two reads (review 1): its own
# listener is never taken for a foreign one. The hook holds the first
# check of the wait between its reads until the stub dx (binding 1 s in)
# listens.
fport=$(free_port)
hook=$dir/ownership-hook
hook_done=$dir/ownership-hook-done
cat >"$hook" <<'EOF'
#!/usr/bin/env bash
# Once: wait up to 10 s for a listener on $HOOK_PORT. It also prints a
# line, which must never be read as a listener (review 2).
[ -s "$HOOK_DONE" ] && exit 0
echo 1 >"$HOOK_DONE"
echo "ownership hook ran"
suffix=$(printf ':%04X' "$HOOK_PORT")
for _ in $(seq 1 100); do
    awk -v s="$suffix" '$4 == "0A" && substr($2, length($2) - 4) == s { f = 1 } END { exit !f }' /proc/net/tcp && exit 0
    sleep 0.1
done
EOF
chmod +x "$hook"
: >"$hook_done"
out=$(timeout 30 "${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" DX_BIND_DELAY=1 \
    CHECK_SERVER_TEST_OWNERSHIP_HOOK="$hook" HOOK_DONE="$hook_done" HOOK_PORT="$fport" scripts/check-server start HEAD 2>&1)
rc=$?
[ -s "$hook_done" ] || fail "the ownership hook never ran"
[ "$rc" = 0 ] || fail "dx binding between the ownership reads: start exited $rc: $out"
grep -qF "check server up at http://localhost:$fport/" <<<"$out" || fail "dx binding between the ownership reads: start said: $out"
"${cs_env[@]}" CHECK_WORKTREE="$worktree" CHECK_PORT="$fport" scripts/check-server stop >/dev/null 2>&1

finish
