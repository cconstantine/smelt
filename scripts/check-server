#!/usr/bin/env bash
# A check server for hands-on checks: `dx serve` from a separate git worktree,
# so saving a file in the working tree doesn't rebuild and restart it
# (docs/process/rules-running.md, "Run hands-on checks against a server that doesn't
# watch the files you're editing").
#
#   scripts/check-server start [REF] [-- KEY=VALUE ...]   build and serve REF (default: HEAD)
#   scripts/check-server stop                             stop it, and everything it started
#   scripts/check-server status
#
# KEY=VALUE pairs override the environment for this server only, e.g.
# `-- SANDBOX_MEMORY_LIMIT=2Gi`. They win over .env, which never overrides a
# variable that's already set. (To make compaction happen quickly, set a
# small context window on the model's row at /providers.)
#
# A REF from before SME-115's fix (6c9f03c) is refused outright, whatever
# database it would serve (SME-186 B39): such a smelt sweeps the shared
# sandbox namespace for claims whose conversation isn't in the database it
# serves, so one on any other database deletes those conversations'
# /workspace. It can't serve on the dev database either — sqlx::migrate!()
# runs first and fails on a database holding migrations the ref doesn't,
# which the dev one has held for months — so what's refused is only ever a
# server that would do that harm. Merge origin/main into the ref to serve it.
#
# The server logs at RUST_LOG=info, without colour (NO_COLOR=1), unless a
# non-empty value is given as an override, in the environment or in the
# check worktree's .env, so its log records what startup and teardown
# deleted (SME-117). The log is $CHECK_WORKTREE/.check-server.log; start
# keeps the previous run's as .check-server.log.prev.
#
# Settings (environment):
#   CHECK_WORKTREE  the worktree (default: ../smelt-check-<this checkout's
#                   name>, or $TMPDIR/smelt-check-<name> when its parent isn't
#                   writable — one per checkout, so two never share a server)
#   CHECK_PORT      the app's port (default: 8081; the dev server uses 8080)
#   CHECK_PORT_WAIT how long start waits for a port another check server
#                   holds, in seconds (default: 1800; 0 gives up at once).
#                   On timeout it exits 1, naming the holder and the `stop`
#                   that would free the port, having checked nothing out and
#                   created, written or signalled nothing (SME-186 B48).
#   CHECK_SCRATCH_DB=1  serve from a database of its own, created on start
#                   (smelt migrates it) and dropped on stop, instead of the dev
#                   database. For when the dev database has migrations from
#                   another branch, which stop smelt starting: on SME-65 every
#                   page was a 500 because SME-35's branch had applied one.
#                   Nothing from the dev database is copied into it.
#
#                   stop deletes that database's own sandbox objects first
#                   (SME-129): every pod and claim its server made carries
#                   smelt/instance=<the database's id>, and once the
#                   database is dropped no server ever owns them again. A
#                   failed cleanup keeps the database, so stop can be run
#                   again; start over a leftover cleans that one up before
#                   recreating it. Nothing without that exact label is
#                   touched, and the tool refuses a target that isn't a
#                   smelt_scratch_* database.
#
# `dx serve` runs its server as a child process, so stopping only the `dx`
# process leaves the server running (SME-51). This starts `dx` in a process
# group of its own and stops the whole group.
#
# Check servers on different CHECK_PORTs can run at once. start takes a lock
# on its port ($SMELT_LOCK_DIR/smelt-check-server-<port>.lock, next to the
# cluster lock), which the server's process group holds for as long as it
# runs: a second start on the same port waits for the first to stop. It
# takes no cluster lock, since nothing it touches is a test run's, and the
# server never inherits one from its caller (SME-100). Two at once also
# need previews of their own (`-- SMELT_PREVIEW_ADDR=0.0.0.0:<p>
# SMELT_PREVIEW_URL=http://{port}-{conversation}.preview.localhost:<p>`):
# both default to 8181, so the second runs without previews and its links
# point at the first's listener.
#
# The port lock keeps out other check servers only. start refuses a port
# anything else already listens on (a hand-run ./server or dx serve, an
# older copy of this script's server, another user's process), on any
# address, before it checks anything out, naming the listener (SME-175).
# It never stops a server it didn't start: stop that one yourself, or use
# another CHECK_PORT. While it waits for the server, an answer counts only
# when every listener on the port is in the server's own process group,
# before and after each request; one that isn't, seen at any of those
# checks, ends the start with exit 1, naming it, and leaves this server to
# stop. Only this network namespace's sockets are seen, and a listener that
# comes and goes between two checks isn't (SME-175 review 2).
#
# A start and a stop of the same scratch database take a lock on the
# database's own name ($SMELT_LOCK_DIR/smelt-check-scratch-<name>.lock)
# around every step that reads or writes that database or its state file,
# so a start in the same worktree can't create it under a stop that is
# cleaning it up, or the other way round (SME-129). stop's cleanup tool
# inherits it until it ends, and the server never holds it.
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
# A check worktree per checkout (SME-186 B41): one shared default means two
# checkouts share a pid file, a port lock and the scratch database named after
# the worktree, so one's `stop` is another's server. Next to the repo, unless
# its parent isn't writable (a container whose repo is at /app, say): then
# under $TMPDIR.
if [ -w "$repo/.." ]; then
    default_worktree=$repo/../smelt-check-$(basename "$repo")
else
    default_worktree=${TMPDIR:-/tmp}/smelt-check-$(basename "$repo")
fi
worktree=${CHECK_WORKTREE:-$default_worktree}
port=${CHECK_PORT:-8081}
lock_dir=${SMELT_LOCK_DIR:-$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)}
port_lock=$lock_dir/smelt-check-server-$port.lock
# The state files are emptied, never removed, so a session can run this
# unattended (SME-107): an empty or missing one means nothing to stop.
# Holds the running server's process group id.
pid_file() { echo "$worktree/.check-server.pid"; }
log_file() { echo "$worktree/.check-server.log"; }
# Holds the scratch database's URL while one exists, so `stop` can drop it.
scratch_db_file() { echo "$worktree/.check-server.scratch-db"; }
# Holds the KUBECONFIG the server was started with, so `stop`'s cleanup talks
# to the same cluster (SME-129). Empty means the inherited environment.
kubeconfig_file() { echo "$worktree/.check-server.kubeconfig"; }

# The dev DATABASE_URL: the environment's, else the check worktree's .env read
# as dotenvy reads it (SME-186 B40 — the server itself gets its URL through
# dotenvy, so the two have to read the line the same way).
dev_database_url() {
    local url=${DATABASE_URL:-}
    if [ -z "$url" ] && [ -f "$worktree/.env" ]; then
        url=$(env_file_value DATABASE_URL)
    fi
    echo "$url"
}

# A database URL's database name: what the scratch lock is keyed by.
db_name() {
    local url=$1
    url=${url%%\?*}
    echo "${url##*/}"
}

# The dev DATABASE_URL (the environment's, else the worktree's .env) with the
# database renamed after the worktree: a fixed name, so a leftover from a
# failed run is easy to find and the next run reuses it.
scratch_db_url() {
    local url
    url=$(dev_database_url)
    [ -n "$url" ] || { echo "CHECK_SCRATCH_DB needs DATABASE_URL (environment or .env)" >&2; return 1; }
    local query=""
    case "$url" in *\?*) query="?${url#*\?}"; url=${url%%\?*} ;; esac
    local name
    name=smelt_scratch_$(basename "$worktree" | tr -c 'a-zA-Z0-9\n' '_')
    echo "${url%/*}/$name$query"
}

# The lock ordering a start and a stop of the same scratch database
# (SME-129): keyed by the database's name, so it works before the check
# worktree exists and whatever CHECK_PORT each side uses. Descriptor 9: the
# cleanup tool a stop runs inherits it, and start waits for the tool to end,
# while the dx subshell below closes it, so the server never holds it.
take_scratch_lock() { # scratch database name
    exec 9>>"$lock_dir/smelt-check-scratch-$1.lock"
    if ! flock -n 9; then
        echo "waiting for the scratch lock: a check-server start or stop in $worktree holds it" >&2
        flock 9
    fi
}

# Deletes the sandbox objects (pods, then claims) of the instance the scratch
# database `$1` names (SME-129), before the database is dropped: its
# smelt_instance row is the last record of the instance its server labelled
# them with, and once it is dropped no server ever owns them again. Succeeds
# when there is nothing to know (no database, or one never migrated) and when
# `$1` is empty. The tool refuses anything that isn't a smelt_scratch_*
# database, and deletes nothing without the exact instance label.
cleanup_scratch() { # scratch database url (may be empty)
    local url=$1
    [ -n "$url" ] || return 0
    local cleanup
    if [ -n "${SANDBOX_INSTANCE_CLEANUP:-}" ]; then
        cleanup=("$SANDBOX_INSTANCE_CLEANUP")
    else
        cleanup=(cargo run -q --bin sandbox_instance_cleanup --features server --)
    fi
    local kubeconfig
    kubeconfig=$(cat "$(kubeconfig_file)" 2>/dev/null || true)
    local -a kube=()
    [ -n "$kubeconfig" ] && kube=(KUBECONFIG="$kubeconfig")
    (
        cd "$repo"
        env "${kube[@]}" "${cleanup[@]}" \
            --database-url "$url" --dev-database-url "$(dev_database_url)" </dev/null
    )
}

drop_scratch_db() {
    local file
    file=$(scratch_db_file)
    [ -s "$file" ] || return 0
    sqlx database drop -y --database-url "$(cat "$file")" >/dev/null
    : >"$file"
    echo "dropped the scratch database"
}

# The settings and /proc helpers, in their own files because this one is at
# the size ceiling (SME-186 review 1, finding 4): sourced here, never run.
. "$repo/scripts/lib/check-server-config.sh"
. "$repo/scripts/lib/check-server-proc.sh"

# Cleans up the scratch database's objects and drops it, then empties the
# KUBECONFIG file. Everything is kept when the cleanup can't finish, so a
# later stop retries.
finish_stop() { # scratch database url (may be empty)
    if ! cleanup_scratch "$1"; then
        echo "the scratch database's sandbox objects weren't all deleted; scripts/check-server stop again (it retries) — the database is kept so they can still be found" >&2
        return 1
    fi
    drop_scratch_db
    # Only a start writes it, so a stop with none leaves it alone. An `if`,
    # not `&&`: as the function's last command, a missing file would make it
    # fail, and stop exit 1 after a cleanup and drop that succeeded.
    if [ -e "$(kubeconfig_file)" ]; then
        : >"$(kubeconfig_file)"
    fi
}

stop() {
    # The scratch lock first, before the pid file is read, and held through
    # the kill, the cleanup and the drop: a start in the same worktree holds
    # it until its pid file is written, so it can't create the database under
    # this cleanup, or have this stop drop the one it just made (SME-129).
    # Taken only when the scratch file names a database; the unlocked read
    # says whether one is, and it is read again under the lock.
    local scratch_url
    scratch_url=$(cat "$(scratch_db_file)" 2>/dev/null || true)
    if [ -n "$scratch_url" ]; then
        take_scratch_lock "$(db_name "$scratch_url")"
        scratch_url=$(cat "$(scratch_db_file)" 2>/dev/null || true)
    fi

    local pgid
    if ! pgid=$(running_pgid); then
        # A pid file naming a live group that running_pgid turned down: say
        # so, signal nothing, and leave everything else alone. The id may
        # well have been reused — but a live group that fails the shape
        # check is also exactly what this worktree's own server looks like
        # once its port lock file has been moved or unlinked (a rename takes
        # the name off the descriptors that hold it: /proc/<pid>/fd reads
        # `… (deleted)`), and on that reading emptying the pid file and
        # dropping the scratch database here tears a live server down. The
        # safe half of both readings: keep the files, keep the database, and
        # let a person tell them apart (SME-186 B41, review 1 finding 2).
        if pgid=$(pid_file_pgid) && group_is_live "$pgid"; then
            echo "the pid file names process group $pgid, which isn't this worktree's check server; not signalling it, and keeping the pid file and the scratch database — if this is this worktree's server under a lock file that was moved or unlinked, that's what protects it" >&2
            return 0
        fi
        echo "no check server running (log: $(log_file))"
        [ -e "$(pid_file)" ] && : >"$(pid_file)"
        finish_stop "$scratch_url"
        return 0
    fi
    kill -TERM -- "-$pgid" 2>/dev/null || true
    for _ in $(seq 1 20); do
        group_is_live "$pgid" || break
        sleep 0.5
    done
    if group_is_live "$pgid"; then
        kill -KILL -- "-$pgid" 2>/dev/null || true
    fi
    : >"$(pid_file)"
    echo "stopped the check server (process group $pgid; log: $(log_file))"
    # Only once the server is gone: Postgres won't drop a database in use,
    # and nothing may make new objects under the cleanup.
    finish_stop "$scratch_url"
}

start() {
    # A plain decimal port, before anything else (SME-175 review 2): a
    # leading zero is read as octal by the port checks, which then look at
    # another port than dx binds, and names another lock file.
    if ! [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$port" -gt 65535 ]; then
        echo "CHECK_PORT must be a port number from 1 to 65535, written without a leading zero: '$port'" >&2
        exit 2
    fi
    # How long to wait for a port another check server holds, validated the
    # same way and just as early (SME-186 B48): before this there was no bound
    # at all, so one forgotten server on the port hung every later start.
    local port_wait=${CHECK_PORT_WAIT:-1800}
    if ! [[ "$port_wait" =~ ^[0-9]+$ ]]; then
        echo "CHECK_PORT_WAIT must be a number of seconds to wait for a port another check server holds (0 gives up at once): '$port_wait'" >&2
        exit 2
    fi
    local ref=HEAD
    if [ $# -gt 0 ] && [ "$1" != "--" ]; then
        ref=$1
        shift
    fi
    [ "${1:-}" = "--" ] && shift
    local overrides=("$@")

    local commit
    commit=$(git -C "$repo" rev-parse --verify "$ref^{commit}")
    # Before anything is checked out, created or started (SME-115): a
    # smelt from before the fix sweeps the shared sandbox namespace for
    # claims whose conversation isn't in its own database, so one on an
    # empty database deletes the dev server's conversations' /workspace.
    # The fix is complete from 6c9f03c on (fresh ids): a commit partway
    # through it has the smelt_instance migration but still sweeps every
    # claim, so ancestry is the test, not the migration (SME-115 review).
    # A repository without that commit refuses too. Refused whatever
    # database the server would get, not only with CHECK_SCRATCH_DB=1
    # (SME-186 B39): `-- DATABASE_URL=<another database>`, or one inherited
    # from the environment, walked past the old condition into exactly the
    # harm the refusal is here for. Such a ref can't usefully serve on the
    # dev database either, so nothing that worked before stops working:
    # smelt runs sqlx::migrate!().run() before the sweep, and sqlx fails
    # with VersionMissing on a database holding migrations the ref doesn't.
    if ! git -C "$repo" merge-base --is-ancestor 6c9f03c "$commit" 2>/dev/null; then
        echo "$ref ($commit) is refused: it predates SME-115's fix, so its server sweeps every sandbox claim that isn't in the database it serves, deleting the conversations of every other server's. Merge origin/main into it, or serve a ref from 6c9f03c on" >&2
        exit 1
    fi
    # The scratch lock, after the refusals (a refused start never waits) and
    # before the "already running" check, held until this start writes its
    # pid file: a stop of the same database waits for it, so it can't take
    # its no-server branch and drop a database a starting server is about to
    # use (SME-129). A start that has to wait says so.
    local db_url
    if [ "${CHECK_SCRATCH_DB:-}" = 1 ]; then
        db_url=$(scratch_db_url)
        take_scratch_lock "$(db_name "$db_url")"
    fi

    if running_pgid >/dev/null; then
        echo "a check server is already running; scripts/check-server stop first" >&2
        exit 1
    fi
    # The port, after the refusals (a refused start never waits) and before
    # anything is checked out, created or started (a waiting start has
    # changed nothing). Descriptor 8 is handed to the server below, so its
    # process group holds the lock while it runs; stop, a crash or a kill
    # frees it (SME-100).
    exec 8>>"$port_lock"
    if ! flock -n 8; then
        find_port_holder
        # Built up in pieces rather than interpolated: an apostrophe inside a
        # ${var:-word} expansion breaks bash's own parser, and the fallback
        # text wants one.
        local holder_where="another worktree" holder_who=""
        [ -n "$holder_dir" ] && holder_where="$holder_dir"
        [ -n "$holder_pid" ] && holder_who=" (pid $holder_pid, $holder_cmd)"
        echo "waiting for port $port: a check server from $holder_where holds it$holder_who; waiting up to ${port_wait}s and then giving up — scripts/check-server stop there, or use another CHECK_PORT" >&2
        # Bounded (SME-186 B48). On timeout nothing has been checked out,
        # created, written or signalled, and exiting frees descriptors 8 and 9.
        if ! flock -w "$port_wait" 8; then
            # Who holds it now — it may be someone else by now, and the stop
            # command is only useful with the directory that holds the server.
            find_port_holder
            if [ -n "$holder_pid" ]; then
                echo "port $port: still held after ${port_wait}s by pid $holder_pid ($holder_cmd) in $holder_dir. If that check server is yours to stop: CHECK_WORKTREE=$holder_dir CHECK_PORT=$port scripts/check-server stop; otherwise use another CHECK_PORT" >&2
            else
                echo "port $port: still held after ${port_wait}s by a check server in another worktree this user can't see. Stop it there, or use another CHECK_PORT" >&2
            fi
            exit 1
        fi
    fi
    # Anything else listening on the port, after the lock (a start that
    # waited checks once the server before it has stopped) and before
    # anything is checked out, created or started (SME-175): the lock keeps
    # out other check servers only, and whatever else answers there would
    # pass for this server. Exiting frees the locks; nothing is signalled.
    local foreign
    foreign=$(foreign_listener_inodes "" "$port")
    if [ -n "$foreign" ]; then
        # shellcheck disable=SC2086 # one inode per word
        echo "port $port is taken: $(describe_listeners $foreign) listens on it. check-server never stops a server it didn't start: stop that one yourself, or use another CHECK_PORT" >&2
        exit 1
    fi
    if [ -d "$worktree" ]; then
        git -C "$worktree" checkout -q --detach "$commit"
    else
        git -C "$repo" worktree add -q --detach "$worktree" "$commit"
    fi
    # The dev .env (never printed), and headless Chrome for webfetch and
    # browsing sessions: without BROWSER_CHECK_CACHE, headless_chrome.rs
    # looks under the checkout it was built from, and a fresh worktree has
    # none (SME-51, SME-69).
    [ -f "$worktree/.env" ] || { [ -f "$repo/.env" ] && cp "$repo/.env" "$worktree/.env"; }
    # One already set (environment, else .env) is kept only when absolute:
    # the server runs from the worktree, where a relative one finds nothing.
    local cache given
    given=${BROWSER_CHECK_CACHE:-$(env_file_value BROWSER_CHECK_CACHE)}
    if [[ "$given" != /* ]] && cache=$(browser_check_cache); then
        # Before the caller's overrides, so an explicit one still wins.
        overrides=("BROWSER_CHECK_CACHE=$cache" "${overrides[@]}")
    fi
    # Pods run the served ref's own agent, from the image named after its
    # sources (SME-102), unless one is given (environment, .env or an
    # override). A ref from before SME-102 has no scripts/sandbox-image-ref
    # and keeps `:latest`. The caller's cluster-doctor checks the node has
    # it before anything is built.
    local image derived=""
    image=$(effective_value SANDBOX_IMAGE)
    if [ -z "$image" ] && [ -x "$worktree/scripts/sandbox-image-ref" ]; then
        image=$("$worktree/scripts/sandbox-image-ref")
        derived=1
        overrides=("SANDBOX_IMAGE=$image" "${overrides[@]}")
    fi
    if [ -n "$image" ] && ! SANDBOX_IMAGE=$image "$repo/scripts/cluster-doctor"; then
        # The doctor's own advice is for this checkout. An image named after
        # the served ref's sources is built from the check worktree (SME-102
        # review); one that was given is the giver's to build.
        if [ -n "$derived" ]; then
            echo "check-server: build $image from the served ref: (cd $worktree && scripts/build-sandbox-image.sh)" >&2
        fi
        exit 1
    fi
    if [ "${CHECK_SCRATCH_DB:-}" = 1 ]; then
        # A leftover scratch database's objects are cleaned up before it is
        # dropped and made again (SME-129): dropping it strands every pod and
        # claim its server labelled, since nothing else names its instance.
        # One the state files still record goes first, with the URL and the
        # KUBECONFIG it was recorded with (SME-129 review): this start's could
        # name another cluster, where the tool finds nothing and succeeds, or
        # another host, where it reports the database missing, and either way
        # its objects would be stranded. A failure leaves both files as they
        # were, for `stop` to retry.
        local leftover
        leftover=$(cat "$(scratch_db_file)" 2>/dev/null || true)
        if [ -n "$leftover" ]; then
            if ! cleanup_scratch "$leftover"; then
                echo "start: the leftover scratch database's sandbox objects weren't all deleted; scripts/check-server stop (it retries), then start again" >&2
                exit 1
            fi
            drop_scratch_db
        fi
        # Then the URL and the cluster are recorded, so the cleanup of a
        # database at the fixed name that no file recorded talks to the
        # server's own cluster, and a failed start's `stop` knows which
        # database to finish.
        echo "$db_url" >"$(scratch_db_file)"
        effective_value KUBECONFIG >"$(kubeconfig_file)"
        if ! cleanup_scratch "$db_url"; then
            echo "start: the leftover scratch database's sandbox objects weren't all deleted; scripts/check-server stop (it retries), then start again" >&2
            exit 1
        fi
        # Start from an empty database, even after a run that failed to drop it.
        sqlx database drop -y --database-url "$db_url" >/dev/null
        sqlx database create --database-url "$db_url"
        # Before the caller's overrides, so an explicit DATABASE_URL still wins.
        overrides=("DATABASE_URL=$db_url" "${overrides[@]}")
        echo "serving from scratch database ${db_url##*/}"
    fi

    # smelt logs errors only unless RUST_LOG says otherwise, which left
    # no record of what a check server's startup and teardown deleted
    # (SME-115, SME-117). A level given anywhere is kept. The chosen one
    # goes last, so smelt gets exactly what's printed: an empty override
    # can't undo it, and an empty RUST_LOG in the environment, which
    # dotenvy treats as set, can't hide .env's.
    local log_level log_note no_color
    log_level=$(effective_value RUST_LOG)
    case "$(effective_source RUST_LOG)" in
        "") log_level=info log_note="check-server's default" ;;
        .env) log_note="from .env" ;;
        *) log_note=yours ;;
    esac
    # Colour codes in the log break grep on field names (`claim=`).
    no_color=$(effective_value NO_COLOR)
    overrides+=("RUST_LOG=$log_level" "NO_COLOR=${no_color:-1}")

    # The run before is kept, so one more start can't lose the run being
    # looked into.
    [ -s "$(log_file)" ] && cp "$(log_file)" "$(log_file).prev"
    : >"$(log_file)"
    (
        cd "$worktree"
        # Only the port lock goes on to the server: a descriptor inherited
        # from the caller, such as an old outer flock's on the cluster lock,
        # would otherwise be held for as long as the server runs (SME-100).
        for fd in /proc/$BASHPID/fd/*; do
            fd=${fd##*/}
            case $fd in 0 | 1 | 2 | 8 | 255) ;; *) eval "exec $fd>&-" ;; esac
        done
        exec setsid env "${overrides[@]}" dx serve --fullstack --addr 0.0.0.0 --port "$port" \
            >"$(log_file)" 2>&1 </dev/null
    ) &
    # setsid made the child a group leader: its pid is the group's id.
    local pgid=$!
    echo "$pgid" >"$(pid_file)"
    # The pid file is written, so a stop may take over from here: this start
    # lets go of the scratch lock before it waits for the server to answer,
    # which can take minutes (SME-129).
    if [ "${CHECK_SCRATCH_DB:-}" = 1 ]; then
        exec 9>&-
    fi
    echo "building $(git -C "$worktree" log --oneline -1) (log: $(log_file))"
    echo "logging at RUST_LOG=$log_level ($log_note)"

    local deadline=$((SECONDS + 720))
    while [ "$SECONDS" -lt "$deadline" ]; do
        port_owned_or_exit "$pgid"
        # Only once a listener is up, and only ours (SME-175): any other
        # listener's answer would pass for this server's. A 2xx only:
        # while dx is still building it answers with a 500, which once
        # passed for up (SME-53). -4 because dx binds IPv4 only, and curl
        # tries localhost's ::1 first; the Host header stays localhost.
        # --noproxy: curl sends even localhost through an http_proxy in the
        # environment, whose answer isn't the server's (review 1).
        if [ -n "$(port_listener_inodes "$port")" ] &&
            curl -4 --noproxy '*' -sf -o /dev/null --max-time 60 "http://localhost:$port/"; then
            # And still only ours once it answered.
            port_owned_or_exit "$pgid"
            echo "check server up at http://localhost:$port/"
            return 0
        fi
        sleep 0.5
    done
    echo "not up after 12 minutes; see $(log_file)" >&2
    exit 1
}

# The readiness wait's check (SME-175): exits 1 when the server's group $1
# has ended (dx serve exited), or when a process outside it listens on the
# port, naming that one either way. A dx whose port was taken may exit or
# stay alive, so both are checked. Leaves this server for stop, like the
# wait's other failures; nothing is signalled.
port_owned_or_exit() { # pgid
    local dead="" foreign
    group_is_live "$1" || dead=1
    foreign=$(foreign_listener_inodes "$1" "$port")
    [ -n "$dead$foreign" ] || return 0
    [ -n "$dead" ] && echo "dx serve exited; see $(log_file)" >&2
    if [ -n "$foreign" ]; then
        # shellcheck disable=SC2086 # one inode per word
        echo "port $port: $(describe_listeners $foreign) listens on it, not this check server, so its answers can't be told from this one's. check-server never stops a server it didn't start: stop that one yourself, or use another CHECK_PORT; scripts/check-server stop stops this one and leaves that one alone" >&2
    fi
    exit 1
}

case "${1:-}" in
    start) shift; start "$@" ;;
    stop) stop ;;
    status)
        if pgid=$(running_pgid); then
            echo "running (process group $pgid) at http://localhost:$port/, $(git -C "$worktree" log --oneline -1) (log: $(log_file))"
        else
            echo "not running (log: $(log_file))"
        fi
        ;;
    *)
        # The whole header, whatever lines it runs to now (the test that the
        # usage is the header compares against it line by line).
        awk 'NR > 1 { if (/^set -euo pipefail/) exit; print }' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
