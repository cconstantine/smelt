#!/usr/bin/env bash
# A check server for hands-on checks: `dx serve` from a separate git worktree,
# so saving a file in the working tree doesn't rebuild and restart it
# (development-process.md, "Run hands-on checks against a server that doesn't
# watch the files you're editing").
#
#   scripts/check-server start [REF] [-- KEY=VALUE ...]   build and serve REF (default: HEAD)
#   scripts/check-server stop                             stop it, and everything it started
#   scripts/check-server status
#
# KEY=VALUE pairs override the environment for this server only, e.g.
# `-- SANDBOX_MEMORY_LIMIT=2Gi`. They win over .env, which never overrides a
# variable that's already set. (To make compaction happen quickly, set a
# small context window on the model's row at /providers.)
#
# The server logs at RUST_LOG=info, without colour (NO_COLOR=1), unless a
# non-empty value is given as an override, in the environment or in the
# check worktree's .env, so its log records what startup and teardown
# deleted (SME-117). The log is $CHECK_WORKTREE/.check-server.log; start
# keeps the previous run's as .check-server.log.prev.
#
# Settings (environment):
#   CHECK_WORKTREE  the worktree (default: ../smelt-check next to this repo,
#                   or $TMPDIR/smelt-check when that isn't writable)
#   CHECK_PORT      the app's port (default: 8081; the dev server uses 8080)
#   CHECK_SCRATCH_DB=1  serve from a database of its own, created on start
#                   (smelt migrates it) and dropped on stop, instead of the dev
#                   database. For when the dev database has migrations from
#                   another branch, which stop smelt starting: on SME-65 every
#                   page was a 500 because SME-35's branch had applied one.
#                   Nothing from the dev database is copied into it.
#                   Refused for a REF without SME-115's fix (6c9f03c): such a server
#                   on a scratch database deletes the sandbox claims (each
#                   conversation's /workspace) of every conversation on the
#                   dev server.
#
# `dx serve` runs its server as a child process, so stopping only the `dx`
# process leaves the server running (SME-51). This starts `dx` in a process
# group of its own and stops the whole group.
#
# Check servers on different CHECK_PORTs can run at once. start takes a lock
# on its port ($SMELT_LOCK_DIR/smelt-check-server-<port>.lock, next to the
# cluster lock), which the server's process group holds for as long as it
# runs: a second start on the same port waits for the first to stop. It
# takes no cluster lock, since nothing it touches is a test run's, and the
# server never inherits one from its caller (SME-100). Two at once also
# need previews of their own (`-- SMELT_PREVIEW_ADDR=0.0.0.0:<p>
# SMELT_PREVIEW_URL=http://{port}-{conversation}.preview.localhost:<p>`):
# both default to 8181, so the second runs without previews and its links
# point at the first's listener.
set -euo pipefail

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
# Next to the repo, unless its parent isn't writable (a container whose
# repo is at /app, say): then under $TMPDIR.
if [ -w "$repo/.." ]; then
    default_worktree=$repo/../smelt-check
else
    default_worktree=${TMPDIR:-/tmp}/smelt-check
fi
worktree=${CHECK_WORKTREE:-$default_worktree}
port=${CHECK_PORT:-8081}
lock_dir=${SMELT_LOCK_DIR:-$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)}
port_lock=$lock_dir/smelt-check-server-$port.lock
# The state files are emptied, never removed, so a session can run this
# unattended (SME-107): an empty or missing one means nothing to stop.
# Holds the running server's process group id.
pid_file() { echo "$worktree/.check-server.pid"; }
log_file() { echo "$worktree/.check-server.log"; }
# Holds the scratch database's URL while one exists, so `stop` can drop it.
scratch_db_file() { echo "$worktree/.check-server.scratch-db"; }

# The dev DATABASE_URL (the environment's, else the worktree's .env) with the
# database renamed after the worktree: a fixed name, so a leftover from a
# failed run is easy to find and the next run reuses it.
scratch_db_url() {
    local url=${DATABASE_URL:-}
    if [ -z "$url" ] && [ -f "$worktree/.env" ]; then
        url=$(sed -n 's/^DATABASE_URL=//p' "$worktree/.env" | tail -n 1)
        url=${url%\"}
        url=${url#\"}
    fi
    [ -n "$url" ] || { echo "CHECK_SCRATCH_DB needs DATABASE_URL (environment or .env)" >&2; return 1; }
    local query=""
    case "$url" in *\?*) query="?${url#*\?}"; url=${url%%\?*} ;; esac
    local name
    name=smelt_scratch_$(basename "$worktree" | tr -c 'a-zA-Z0-9\n' '_')
    echo "${url%/*}/$name$query"
}

drop_scratch_db() {
    local file
    file=$(scratch_db_file)
    [ -s "$file" ] || return 0
    sqlx database drop -y --database-url "$(cat "$file")" >/dev/null
    : >"$file"
    echo "dropped the scratch database"
}

# NAME's value in the worktree's .env, as dotenvy reads it: the first line
# setting it (dotenvy never overrides a value it has set), with or without
# `export`, spaces around `=` allowed. A quoted value is what's inside its
# quotes; an unquoted one ends at a ` #` comment (SME-117 review 1: a
# `RUST_LOG=debug # note` passed on whole silenced smelt's log entirely).
env_file_value() {
    local value
    value=$(sed -En "s/^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=[[:space:]]*//p" "$worktree/.env" 2>/dev/null | head -n 1)
    case "$value" in
        \"*) value=${value#\"}; value=${value%%\"*} ;;
        \'*) value=${value#\'}; value=${value%%\'*} ;;
        # Nothing before a comment: empty, as dotenvy reads it (SME-117
        # review 2: `RUST_LOG= # note` silenced smelt's log).
        \#*) value="" ;;
        *)
            value=${value%%[[:space:]]#*}
            value=${value%"${value##*[![:space:]]}"}
            ;;
    esac
    echo "$value"
}

# The value of the last `-- NAME=` override given to start (in start's
# `overrides`), which may be empty; fails when there is none.
override_value() {
    local override value found=""
    for override in "${overrides[@]}"; do
        if [[ "$override" == "$1="* ]]; then
            value=${override#"$1="}
            found=1
        fi
    done
    [ -n "$found" ] || return 1
    echo "$value"
}

# Where NAME's value comes from: the first of a `-- NAME=` override, the
# environment and the check worktree's .env that gives it a non-empty
# value ("override", "environment" or ".env"). Fails when none does: an
# empty value counts as unset.
effective_source() {
    local value
    if value=$(override_value "$1") && [ -n "$value" ]; then
        echo override
    elif [ -n "${!1:-}" ]; then
        echo environment
    elif [ -n "$(env_file_value "$1")" ]; then
        echo .env
    else
        return 1
    fi
}

# NAME's value: the first non-empty of a `-- NAME=` override, the
# environment and the check worktree's .env; empty when none is.
effective_value() {
    case "$(effective_source "$1")" in
        override) override_value "$1" ;;
        environment) echo "${!1}" ;;
        .env) env_file_value "$1" ;;
    esac
}

# Headless Chrome's cache directory: this checkout's, or else the main
# checkout's (a worktree has none of its own).
browser_check_cache() {
    local main
    main=$(dirname "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)")
    for dir in "$repo/.browser-check-cache" "$main/.browser-check-cache"; do
        if [ -d "$dir" ]; then
            (cd "$dir" && pwd -P)
            return 0
        fi
    done
    return 1
}

# The directory of a process outside this one's process group with the port
# lock open: the check server holding the port (its own group, from setsid).
port_holder() {
    local own fd pid
    own=$(ps -o pgid= -p $$ | tr -d ' ')
    for fd in $(find /proc/[0-9]*/fd -maxdepth 1 -lname "$port_lock" 2>/dev/null); do
        pid=${fd#/proc/}
        pid=${pid%%/*}
        [ "$(ps -o pgid= -p "$pid" | tr -d ' ')" = "$own" ] && continue
        readlink "/proc/$pid/cwd" && return 0
    done
    echo "another worktree"
}

running_pgid() {
    local file
    file=$(pid_file)
    [ -s "$file" ] || return 1
    local pgid
    pgid=$(cat "$file")
    # Still ours if a process in that group is still alive.
    pgrep -g "$pgid" >/dev/null 2>&1 || return 1
    echo "$pgid"
}

stop() {
    local pgid
    if ! pgid=$(running_pgid); then
        echo "no check server running (log: $(log_file))"
        [ -e "$(pid_file)" ] && : >"$(pid_file)"
        drop_scratch_db
        return 0
    fi
    kill -TERM -- "-$pgid" 2>/dev/null || true
    for _ in $(seq 1 20); do
        pgrep -g "$pgid" >/dev/null 2>&1 || break
        sleep 0.5
    done
    if pgrep -g "$pgid" >/dev/null 2>&1; then
        kill -KILL -- "-$pgid" 2>/dev/null || true
    fi
    : >"$(pid_file)"
    echo "stopped the check server (process group $pgid; log: $(log_file))"
    # Only once the server is gone: Postgres won't drop a database in use.
    drop_scratch_db
}

start() {
    local ref=HEAD
    if [ $# -gt 0 ] && [ "$1" != "--" ]; then
        ref=$1
        shift
    fi
    [ "${1:-}" = "--" ] && shift
    local overrides=("$@")

    if running_pgid >/dev/null; then
        echo "a check server is already running; scripts/check-server stop first" >&2
        exit 1
    fi

    local commit
    commit=$(git -C "$repo" rev-parse --verify "$ref^{commit}")
    # Before anything is checked out, created or started (SME-115): a
    # smelt from before the fix sweeps the shared sandbox namespace for
    # claims whose conversation isn't in its own database, so one on an
    # empty database deletes the dev server's conversations' /workspace.
    # The fix is complete from 6c9f03c on (fresh ids): a commit partway
    # through it has the smelt_instance migration but still sweeps every
    # claim, so ancestry is the test, not the migration (SME-115 review).
    # A repository without that commit refuses too.
    if [ "${CHECK_SCRATCH_DB:-}" = 1 ] &&
        ! git -C "$repo" merge-base --is-ancestor 6c9f03c "$commit" 2>/dev/null; then
        echo "CHECK_SCRATCH_DB=1 is refused for $ref ($commit): it predates SME-115's fix, so a server serving it on a scratch database deletes the dev server's sandbox claims" >&2
        exit 1
    fi
    # The port, after the refusals (a refused start never waits) and before
    # anything is checked out, created or started (a waiting start has
    # changed nothing). Descriptor 8 is handed to the server below, so its
    # process group holds the lock while it runs; stop, a crash or a kill
    # frees it (SME-100).
    exec 8>>"$port_lock"
    if ! flock -n 8; then
        echo "waiting for port $port: a check server from $(port_holder) holds it; scripts/check-server stop there, or use another CHECK_PORT" >&2
        flock 8
    fi
    if [ -d "$worktree" ]; then
        git -C "$worktree" checkout -q --detach "$commit"
    else
        git -C "$repo" worktree add -q --detach "$worktree" "$commit"
    fi
    # The dev .env (never printed), and headless Chrome for webfetch and
    # browsing sessions: without BROWSER_CHECK_CACHE, headless_chrome.rs
    # looks under the checkout it was built from, and a fresh worktree has
    # none (SME-51, SME-69).
    [ -f "$worktree/.env" ] || { [ -f "$repo/.env" ] && cp "$repo/.env" "$worktree/.env"; }
    # One already set (environment, else .env) is kept only when absolute:
    # the server runs from the worktree, where a relative one finds nothing.
    local cache given
    given=${BROWSER_CHECK_CACHE:-$(env_file_value BROWSER_CHECK_CACHE)}
    if [[ "$given" != /* ]] && cache=$(browser_check_cache); then
        # Before the caller's overrides, so an explicit one still wins.
        overrides=("BROWSER_CHECK_CACHE=$cache" "${overrides[@]}")
    fi
    # Pods run the served ref's own agent, from the image named after its
    # sources (SME-102), unless one is given (environment, .env or an
    # override). A ref from before SME-102 has no scripts/sandbox-image-ref
    # and keeps `:latest`. The caller's cluster-doctor checks the node has
    # it before anything is built.
    local image derived=""
    image=$(effective_value SANDBOX_IMAGE)
    if [ -z "$image" ] && [ -x "$worktree/scripts/sandbox-image-ref" ]; then
        image=$("$worktree/scripts/sandbox-image-ref")
        derived=1
        overrides=("SANDBOX_IMAGE=$image" "${overrides[@]}")
    fi
    if [ -n "$image" ] && ! SANDBOX_IMAGE=$image "$repo/scripts/cluster-doctor"; then
        # The doctor's own advice is for this checkout. An image named after
        # the served ref's sources is built from the check worktree (SME-102
        # review); one that was given is the giver's to build.
        if [ -n "$derived" ]; then
            echo "check-server: build $image from the served ref: (cd $worktree && scripts/build-sandbox-image.sh)" >&2
        fi
        exit 1
    fi
    if [ "${CHECK_SCRATCH_DB:-}" = 1 ]; then
        local db_url
        db_url=$(scratch_db_url)
        # Start from an empty database, even after a run that failed to drop it.
        sqlx database drop -y --database-url "$db_url" >/dev/null
        sqlx database create --database-url "$db_url"
        echo "$db_url" >"$(scratch_db_file)"
        # Before the caller's overrides, so an explicit DATABASE_URL still wins.
        overrides=("DATABASE_URL=$db_url" "${overrides[@]}")
        echo "serving from scratch database ${db_url##*/}"
    fi

    # smelt logs errors only unless RUST_LOG says otherwise, which left
    # no record of what a check server's startup and teardown deleted
    # (SME-115, SME-117). A level given anywhere is kept. The chosen one
    # goes last, so smelt gets exactly what's printed: an empty override
    # can't undo it, and an empty RUST_LOG in the environment, which
    # dotenvy treats as set, can't hide .env's.
    local log_level log_note no_color
    log_level=$(effective_value RUST_LOG)
    case "$(effective_source RUST_LOG)" in
        "") log_level=info log_note="check-server's default" ;;
        .env) log_note="from .env" ;;
        *) log_note=yours ;;
    esac
    # Colour codes in the log break grep on field names (`claim=`).
    no_color=$(effective_value NO_COLOR)
    overrides+=("RUST_LOG=$log_level" "NO_COLOR=${no_color:-1}")

    # The run before is kept, so one more start can't lose the run being
    # looked into.
    [ -s "$(log_file)" ] && cp "$(log_file)" "$(log_file).prev"
    : >"$(log_file)"
    (
        cd "$worktree"
        # Only the port lock goes on to the server: a descriptor inherited
        # from the caller, such as an old outer flock's on the cluster lock,
        # would otherwise be held for as long as the server runs (SME-100).
        for fd in /proc/$BASHPID/fd/*; do
            fd=${fd##*/}
            case $fd in 0 | 1 | 2 | 8 | 255) ;; *) eval "exec $fd>&-" ;; esac
        done
        exec setsid env "${overrides[@]}" dx serve --fullstack --addr 0.0.0.0 --port "$port" \
            >"$(log_file)" 2>&1 </dev/null
    ) &
    # setsid made the child a group leader: its pid is the group's id.
    local pgid=$!
    echo "$pgid" >"$(pid_file)"
    echo "building $(git -C "$worktree" log --oneline -1) (log: $(log_file))"
    echo "logging at RUST_LOG=$log_level ($log_note)"

    for _ in $(seq 1 360); do
        if ! pgrep -g "$pgid" >/dev/null 2>&1; then
            echo "dx serve exited; see $(log_file)" >&2
            exit 1
        fi
        # A 2xx only: while dx is still building it answers with a 500,
        # which once passed for up (SME-53).
        if curl -sf -o /dev/null --max-time 60 "http://localhost:$port/"; then
            echo "check server up at http://localhost:$port/"
            return 0
        fi
        sleep 2
    done
    echo "not up after 12 minutes; see $(log_file)" >&2
    exit 1
}

case "${1:-}" in
    start) shift; start "$@" ;;
    stop) stop ;;
    status)
        if pgid=$(running_pgid); then
            echo "running (process group $pgid) at http://localhost:$port/, $(git -C "$worktree" log --oneline -1) (log: $(log_file))"
        else
            echo "not running (log: $(log_file))"
        fi
        ;;
    *)
        sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
