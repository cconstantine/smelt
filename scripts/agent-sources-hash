#!/usr/bin/env bash
# Prints one hash of everything the sandbox image is built from: the agent's
# sources (with the protocol and docker_net.rs it compiles in), the
# Dockerfile, and Cargo.toml/Cargo.lock, which pick the agent's dependencies
# and features (SME-102 review: a dependency bump is a different agent).
# Over-broad on purpose: any dependency change renames the image, at the
# cost of one rebuild. scripts/sandbox-image-ref names the sandbox image
# after it (`smelt-sandbox:src-<first 16 hex>`), so the image in the
# cluster says which sources built it (SME-102). build.rs hashes the same
# files in the same order for the server's default image (SME-121): change
# the list in both.
#
# The agent's own sources are every .rs file under src/bin/sandbox_agent/,
# in byte order, so a module added there names the image too (SME-163;
# src/sandbox/tests/image.rs and scripts/test-cluster-doctor check it).
# With --list, prints the files instead of their hash.
set -euo pipefail
cd "$(dirname "$0")/.."
files() {
    find src/bin/sandbox_agent -name '*.rs' -type f | LC_ALL=C sort
    printf '%s\n' src/agent_protocol.rs src/docker_net.rs docker/sandbox/Dockerfile Cargo.toml Cargo.lock
}
if [ "${1:-}" = "--list" ]; then
    files
    exit 0
fi
files | while IFS= read -r f; do cat "$f"; done | sha256sum | cut -d' ' -f1
