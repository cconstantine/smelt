#!/usr/bin/env bash
# Writes the local test k3s's admin kubeconfig to target/k3s-admin.yaml, for
# looking into what the `park` service account can't see (kube-system: the
# local-path provisioner and its helper pods, storage classes), e.g. while
# the pod lifecycle tests run (SME-341's speed pass).
#
#   scripts/k3s-admin-kubeconfig
#
# Run it on the host, in this checkout: it reads the file from the compose
# `k3s` service, so it needs the host's `docker compose`. The server address
# is rewritten to `https://k3s:6443`, the name the `smelt` service reaches
# k3s at, so a session in that container reads it as
# /app/target/k3s-admin.yaml (KUBECONFIG=/app/target/k3s-admin.yaml).
#
# It's cluster-admin on this compose stack's k3s only: the test cluster, not
# homelab or the deployed smelt. target/ is gitignored, so it can't be
# committed. To take the access back, empty the file (`: >
# target/k3s-admin.yaml`); `docker compose down -v` makes it useless anyway,
# since a new k3s mints new credentials.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p target
out=target/k3s-admin.yaml
docker compose exec -T k3s cat /etc/rancher/k3s/k3s.yaml \
    | sed 's#https://127.0.0.1:6443#https://k3s:6443#' > "$out.tmp"
if ! grep -q 'server: https://k3s:6443' "$out.tmp"; then
    echo "k3s-admin-kubeconfig: no kubeconfig with the expected server came back (is the compose stack up?)" >&2
    : > "$out.tmp"
    exit 1
fi
chmod 600 "$out.tmp"
mv "$out.tmp" "$out"
echo "wrote $out (cluster-admin on this stack's k3s)"
