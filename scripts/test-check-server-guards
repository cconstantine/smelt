#!/usr/bin/env bash
# scripts/check-server's guards (SME-186): that it reads the check worktree's
# .env as dotenvy does, that a ref from before SME-115's fix is refused
# whatever database it would get, that the wait for the port lock is bounded
# and names the server that holds it, that a pid file only ever claims a group
# that looks like this worktree's server, and that the default check worktree
# belongs to this checkout alone. G8 (SME-226) covers the two database settings:
# each accepts exactly 1, and they refuse each other. The stubs and helpers are
# in scripts/lib/test-check-scripts.sh.
#
#   scripts/test-check-server-guards
. "$(dirname "$0")/lib/test-check-scripts.sh"

# Whatever an earlier, failed run left running.
check_server stop >/dev/null
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"

# G1 (SME-186 B39): a ref from before 6c9f03c, where SME-115's fix is
# complete, is refused whatever database it would be served on. The refusal
# used to be conditional on serving a scratch database (`CHECK_SCRATCH_DB=1`,
# the default since SME-226), so any of these could be started on another
# database — `-- DATABASE_URL=…`, or one inherited from the environment — and
# that server's startup sweep deletes every conversation's sandbox claim that
# isn't in the database it serves: the harm the refusal exists to stop. Such a
# ref can't usefully serve on the dev database either, which is why refusing
# it outright costs nothing: smelt runs sqlx::migrate!() before the sweep, and
# that fails with VersionMissing on a database holding migrations the ref
# doesn't, as the dev one has for months.
port_lock=$SMELT_LOCK_DIR/smelt-check-server-$port.lock
refused_pre_fix_ref() { # name ref [start args...]
    local name=$1 ref=$2 out rc want_head
    shift 2
    # Whatever the previous case left running, and the run before that. A
    # red run's start succeeds, and its server holds the port lock: without
    # this, the next case waits on it forever — B48, which is commit 5's.
    check_server stop >/dev/null
    want_head=$(git -C "$worktree" rev-parse HEAD 2>/dev/null || echo "no checkout")
    : >"$SQLX_CALLS"
    : >"$pid_file"
    : >"$scratch_file"
    out=$(check_server start "$ref" "$@")
    rc=$?
    [ "$rc" = 1 ] || fail "$name: start exited $rc, not 1: $out"
    grep -q "SME-115" <<<"$out" || fail "$name: the refusal doesn't name SME-115: $out"
    grep -qF "$ref" <<<"$out" || fail "$name: the refusal doesn't name the ref: $out"
    [ -s "$SQLX_CALLS" ] && fail "$name: a refused start called sqlx: $(cat "$SQLX_CALLS")"
    [ -s "$pid_file" ] && fail "$name: a refused start wrote a pid file: '$(cat "$pid_file")'"
    [ -s "$scratch_file" ] && fail "$name: a refused start wrote a scratch file: '$(cat "$scratch_file")'"
    [ "$(git -C "$worktree" rev-parse HEAD 2>/dev/null || echo "no checkout")" = "$want_head" ] ||
        fail "$name: a refused start checked $ref out anyway"
    flock -n "$port_lock" true || fail "$name: a refused start took the port lock"
}
old_ref=$(git rev-list --max-parents=0 HEAD | tail -n 1)
for ref in "$old_ref" 7dc5248; do
    refused_pre_fix_ref "a pre-SME-115 ref ($ref) with nothing given" "$ref"
    refused_pre_fix_ref "a pre-SME-115 ref ($ref) with a database as an override" \
        "$ref" -- DATABASE_URL=postgres://u@localhost/empty
    extra_env=(DATABASE_URL=postgres://u@localhost/from-the-environment)
    refused_pre_fix_ref "a pre-SME-115 ref ($ref) with a database in the environment" "$ref"
    extra_env=()
done
# Whatever the red run left running.
check_server stop >/dev/null

# G2 (SME-186 B48): the wait for a port that another check server holds is
# bounded, and names that server — not another start that is only waiting for
# the same lock. The holder is shaped like the real thing: setsid (so it leads
# a session, as `dx` under check-server's setsid does), the port lock open, a
# working directory of its own (the one `stop` has to be told about), alive
# until someone kills it. The waiter has the same lock open and is blocked in
# flock — a second start, never a session leader (its python sets its own
# process group, so it isn't one and it isn't this script's either).
helper_dir=$dir/holder
waiter_dir=$dir/waiter
mkdir -p "$helper_dir" "$waiter_dir"
kill_helper() { # pid: the group it leads if it leads one and it isn't ours
    local pid=$1 pgid own
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
    own=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')
    [ -n "$pgid" ] && [ "$pgid" != "$own" ] && kill -KILL -- "-$pgid" 2>/dev/null
    kill -KILL "$pid" 2>/dev/null
    return 0
}
wait_for_file() { # file
    local _
    for _ in $(seq 1 100); do
        [ -s "$1" ] && return 0
        sleep 0.1
    done
    return 1
}
start_holder() { # dir ready-file
    : >"$2"
    setsid bash -c 'cd "$1" || exit 1; exec 9>"$2" || exit 1; flock 9; echo $$ >"$3"; sleep 120' \
        _ "$1" "$port_lock" "$2" >/dev/null 2>&1 &
    # Forget the job: kill_helper kills it later, and the shell's own
    # 'Killed' notice would read as a failure in a red run (SME-186
    # review 1, finding 6).
    disown
    wait_for_file "$2" || fail "the port holder never wrote its ready file"
    holder_pid=$(cat "$2" 2>/dev/null)
    pid_is_live "$holder_pid" || fail "the port holder (pid $holder_pid) isn't alive"
}
start_waiter() { # dir ready-file
    : >"$2"
    (
        cd "$1" || exit 1
        "$STUB_PYTHON3" -I -c 'import os, sys, fcntl, time
os.setpgrp()
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_CREAT)
open(sys.argv[2], "w").write(str(os.getpid()))
fcntl.flock(fd, fcntl.LOCK_EX)
time.sleep(120)' "$port_lock" "$2" >/dev/null 2>&1 &
    )
    wait_for_file "$2" || fail "the port waiter never wrote its ready file"
    waiter_pid=$(cat "$2" 2>/dev/null)
    pid_is_live "$waiter_pid" || fail "the port waiter (pid $waiter_pid) isn't alive"
}
# The same environment as the lib's check_server(), spelled out so a case can
# run it under timeout — which needs a command, not a shell function.
guard_env=(env -u SANDBOX_IMAGE -u RUST_LOG -u NO_COLOR PATH="$dir/bin:$PATH"
    SANDBOX_IMAGE_IMPORT="$dir/bin/import" SANDBOX_INSTANCE_CLEANUP="$dir/bin/cleanup"
    CHECK_WORKTREE="$worktree" DATABASE_URL=postgres://u@localhost/smelt_dev CHECK_PORT="$port")

# G2: held past the wait, so start gives up — naming the holder, and the stop
# command that would actually free the port. Nothing is checked out, created,
# written or signalled.
start_holder "$helper_dir" "$dir/holder-ready"
start_waiter "$waiter_dir" "$dir/waiter-ready"
flock -n "$port_lock" true && fail "G2: the port lock is free while the holder runs"
scratch_lock=$SMELT_LOCK_DIR/smelt-check-scratch-smelt_scratch_worktree.lock
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"
want_head=$(git -C "$worktree" rev-parse HEAD 2>/dev/null || echo "no checkout")
started_at=$SECONDS
out=$(CHECK_PORT_WAIT=2 CHECK_SCRATCH_DB=1 timeout 30 "${guard_env[@]}" scripts/check-server start HEAD 2>&1)
rc=$?
took=$((SECONDS - started_at))
[ "$rc" = 1 ] || fail "G2: a start held past its wait exited $rc after ${took}s, not 1: $out"
[ "$took" -le 10 ] || fail "G2: a start with CHECK_PORT_WAIT=2 took ${took}s to give up"
grep -qF "port $port" <<<"$out" || fail "G2: the timeout doesn't name the port: $out"
grep -q "after 2s" <<<"$out" || fail "G2: the timeout doesn't say what it waited: $out"
grep -qF "pid $holder_pid" <<<"$out" || fail "G2: the timeout doesn't name the holder's pid: $out"
grep -qF "$helper_dir" <<<"$out" || fail "G2: the timeout doesn't name the holder's directory: $out"
grep -qF "pid $waiter_pid" <<<"$out" && fail "G2: the timeout names the waiting start instead of the server: $out"
grep -qF "$waiter_dir" <<<"$out" && fail "G2: the timeout points at the waiting start's directory: $out"
grep -qF "CHECK_WORKTREE=$helper_dir CHECK_PORT=$port scripts/check-server stop" <<<"$out" ||
    fail "G2: the timeout doesn't give the stop command for the holder's worktree: $out"
[ -s "$SQLX_CALLS" ] && fail "G2: a start that gave up called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$pid_file" ] && fail "G2: a start that gave up wrote a pid file: '$(cat "$pid_file")'"
[ "$(git -C "$worktree" rev-parse HEAD 2>/dev/null || echo "no checkout")" = "$want_head" ] ||
    fail "G2: a start that gave up checked something out"
flock -n "$scratch_lock" true || fail "G2: a start that gave up still holds the scratch lock"
pid_is_live "$holder_pid" || fail "G2: a start that gave up signalled the holder"
kill_helper "$waiter_pid"
kill_helper "$holder_pid"

# G2b: the lock frees within the wait, so start goes ahead — the wait must not
# fire early. The holder releases after a second.
(
    cd "$helper_dir" || exit 1
    : >"$dir/holder2-ready"
    setsid bash -c 'exec 9>"$1"; flock 9; echo $$ >"$2"; sleep 1; exit' _ "$port_lock" "$dir/holder2-ready" >/dev/null 2>&1 &
)
wait_for_file "$dir/holder2-ready" || fail "G2b: the releasing holder never wrote its ready file"
out=$(CHECK_PORT_WAIT=10 CHECK_SCRATCH_DB=1 timeout 60 "${guard_env[@]}" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 0 ] || fail "G2b: a start whose wait ended early exited $rc: $out"
grep -q "check server up" <<<"$out" || fail "G2b: the start didn't come up: $out"
check_server stop >/dev/null

# G2c: CHECK_PORT_WAIT is validated before anything else, like CHECK_PORT.
for bad in abc -1 1.5 ' 5'; do
    # As in G1: a red run's start succeeds and its server holds the port, so
    # the next iteration would wait on it forever.
    check_server stop >/dev/null
    : >"$SQLX_CALLS"
    : >"$pid_file"
    out=$(CHECK_PORT_WAIT="$bad" check_server start HEAD)
    rc=$?
    [ "$rc" = 2 ] || fail "G2c: CHECK_PORT_WAIT='$bad' exited $rc, not 2: $out"
    grep -q "CHECK_PORT_WAIT" <<<"$out" || fail "G2c: CHECK_PORT_WAIT='$bad' didn't say why: $out"
    [ -s "$SQLX_CALLS" ] && fail "G2c: CHECK_PORT_WAIT='$bad' called sqlx: $(cat "$SQLX_CALLS")"
    [ -s "$pid_file" ] && fail "G2c: CHECK_PORT_WAIT='$bad' wrote a pid file"
done
# A red run's G2c start goes ahead, since CHECK_PORT_WAIT means nothing to the
# script before this commit; don't leave it holding the port for G2d.
check_server stop >/dev/null

# G2d: with no CHECK_PORT_WAIT given, the default is named in the waiting line
# and the wait really is that long — so 3 s in, the start is still waiting.
start_holder "$helper_dir" "$dir/holder-ready"
out=$(CHECK_SCRATCH_DB=1 timeout 3 "${guard_env[@]}" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 124 ] || fail "G2d: the default wait didn't hold a start for 3s (exit $rc): $out"
grep -qF "waiting for port $port" <<<"$out" || fail "G2d: the waiting line: $out"
grep -q "1800" <<<"$out" || fail "G2d: the waiting line doesn't name the 1800 s default: $out"
[ -s "$pid_file" ] && fail "G2d: a waiting start wrote a pid file: '$(cat "$pid_file")'"
kill_helper "$holder_pid"
check_server stop >/dev/null

# G2e (SME-186 review 1): the fallback for when nothing leads a session, which
# is the server's `dx` gone and a child left holding descriptor 8, or a start
# sitting between its flock and its setsid. Two non-leaders hold the lock here,
# each in a group of its own and neither its own session leader: the one that
# took the lock first, and one queued behind it. The advice must name the one
# that holds it. A queued start is always the *newest* process with the lock
# open, so newest is wrong every time it's the one named: `stop` then runs in a
# worktree that holds nothing, dropping that start's scratch database while the
# port stays held. The holder predates everything queued behind it on the same
# lock, so it is the one to name.
holder_dir2=$dir/holder-no-leader
waiter_dir2=$dir/waiter-no-leader
mkdir -p "$holder_dir2" "$waiter_dir2"
# A process with the lock open that leads no session: os.setpgrp gives it a
# group of its own (so this script's start doesn't mistake it for a waiter
# beside it, which it skips by group) without making it a session leader.
# `hold` takes the lock before writing its ready file, `wait` writes first and
# then blocks — so the case knows who holds it and who only wants it.
start_plain_locker() { # dir ready-file hold|wait
    : >"$2"
    (
        cd "$1" || exit 1
        "$STUB_PYTHON3" -I -c 'import os, sys, fcntl, time
os.setpgrp()
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_CREAT)
if sys.argv[3] == "hold":
    fcntl.flock(fd, fcntl.LOCK_EX)
open(sys.argv[2], "w").write(str(os.getpid()))
fcntl.flock(fd, fcntl.LOCK_EX)
time.sleep(120)' "$port_lock" "$2" "$3" >/dev/null 2>&1 &
    )
    wait_for_file "$2" || fail "the $3 locker never wrote its ready file"
    local pid
    pid=$(cat "$2" 2>/dev/null)
    pid_is_live "$pid" || fail "the $3 locker (pid $pid) isn't alive"
    echo "$pid"
}
older_pid=$(start_plain_locker "$holder_dir2" "$dir/older-ready" hold)
newer_pid=$(start_plain_locker "$waiter_dir2" "$dir/newer-ready" wait)
flock -n "$port_lock" true && fail "G2e: the port lock is free while the older locker holds it"
out=$(CHECK_PORT_WAIT=2 timeout 30 "${guard_env[@]}" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "G2e: a start held past its wait exited $rc, not 1: $out"
grep -qF "pid $older_pid" <<<"$out" ||
    fail "G2e: with no session leader the timeout doesn't name the locker that holds the lock: $out"
grep -qF "$holder_dir2" <<<"$out" || fail "G2e: the timeout doesn't name that locker's directory: $out"
grep -qF "pid $newer_pid" <<<"$out" &&
    fail "G2e: the timeout names a process queued behind the holder instead: $out"
grep -qF "$waiter_dir2" <<<"$out" &&
    fail "G2e: the timeout points at a queued process's directory: $out"
grep -qF "CHECK_WORKTREE=$holder_dir2 CHECK_PORT=$port scripts/check-server stop" <<<"$out" ||
    fail "G2e: the timeout doesn't give the stop command for the holder's worktree: $out"
pid_is_live "$older_pid" || fail "G2e: a start that gave up signalled the holder"
kill_helper "$newer_pid"
kill_helper "$older_pid"
check_server stop >/dev/null

# G2f (SME-186 review 1, finding 2): the same file moved out from under the
# holder while a start waits on it — flock follows inodes, so the start keeps
# waiting on the moved one. The timeout advice scans /proc afterwards, and an
# unlinked file reads `… (deleted)` there: the exact-name pattern missed the
# holder entirely, and the advice told you to look for "a check server in
# another worktree this user can't see" when it could see it all along.
holder_dir5=$dir/holder-deleted
mkdir -p "$holder_dir5"
holder_pid5=$(start_plain_locker "$holder_dir5" "$dir/deleted-ready" hold)
(
    CHECK_PORT_WAIT=8 timeout 30 "${guard_env[@]}" scripts/check-server start HEAD \
        >"$dir/deleted-start.out" 2>&1 </dev/null &
    spid=$!
    for _ in $(seq 1 100); do
        grep -qF "waiting for port $port" "$dir/deleted-start.out" 2>/dev/null && break
        sleep 0.1
    done
    # A rename within one filesystem would just move the name the descriptor
    # reads; this copy-to-tmpfs-then-unlink is what puts the holder's fd into
    # the `… (deleted)` state the case is about — and it moves the file
    # rather than removing it, as this script's rules ask. The name is
    # per-run so the move never replaces an earlier run's copy.
    mv "$port_lock" "/dev/shm/sme186-guards-deleted-lock.$$"
    wait "$spid"
)
rc=$?
out=$(cat "$dir/deleted-start.out")
[ "$rc" = 1 ] || fail "G2f: the start that outlived the lock file exited $rc, not 1: $out"
grep -qF "waiting for port $port" <<<"$out" || fail "G2f: the start never reached its wait: $out"
# The *timeout* line, not the first one: the first was computed before the
# move and can name the holder the old way even when the timeout can't.
advice=$(grep "still held after" <<<"$out")
[ -n "$advice" ] || fail "G2f: no timeout advice after the lock file was moved: $out"
grep -qF "pid $holder_pid5" <<<"$advice" ||
    fail "G2f: with the lock file unlinked the timeout advice doesn't name the holder: $advice"
grep -qF "$holder_dir5" <<<"$advice" || fail "G2f: the timeout advice doesn't name the holder's directory: $advice"
pid_is_live "$holder_pid5" || fail "G2f: a start that gave up signalled the holder"
kill_helper "$holder_pid5"
check_server stop >/dev/null

# G3 (SME-186 B41): a pid file that names a live group which isn't this
# worktree's server must never be signalled — an id that was reused belongs to
# someone else. Three groups, each leading a session of its own so that
# signalling it means signalling a whole group: (a) in a directory of its own
# with no lock open, (b) holding another port's check-server lock but not
# working in this worktree, (c) working in this worktree with no lock open.
# Only a check-server port lock *and* this worktree's directory is this
# worktree's server; every server start writes the pid file for meets both,
# since its group inherits descriptor 8 and dx runs in the worktree. And
# stop keeps everything the record claims: the same record read the other
# way describes this worktree's own live server whose lock file was
# unlinked, where clearing the files or dropping the database would tear
# down something live (SME-186 review 1, finding 2).
start_group() { # dir ready-file [lock-to-hold]
    : >"$2"
    if [ -n "${3:-}" ]; then
        setsid bash -c 'cd "$1" || exit 1; exec 9>"$3" || exit 1; flock 9; echo $$ >"$2"; exec sleep 120' \
            _ "$1" "$2" "$3" >/dev/null 2>&1 &
    else
        setsid bash -c 'cd "$1" || exit 1; echo $$ >"$2"; exec sleep 120' _ "$1" "$2" >/dev/null 2>&1 &
    fi
    disown # as start_holder's: kill_helper kills this group; no 'Killed' notice
    wait_for_file "$2" || fail "the group never wrote its ready file"
}
stale_pid_group_case() { # name dir [lock]
    local name=$1 group_dir=$2 out rc pgid
    # Whatever the previous case's start left on the port.
    check_server stop >/dev/null
    start_group "$group_dir" "$group_dir/group-ready" "${3:-}"
    pgid=$(cat "$group_dir/group-ready")
    pid_is_live "$pgid" || fail "$name: the group (pid $pgid) isn't alive"
    echo "$pgid" >"$pid_file"
    # The scratch database a server of this worktree left behind. Seeded so
    # the case says what stop may NOT do while an unclaimable group is alive:
    # the record's other reading is this worktree's own server, under a lock
    # that was unlinked (G3b), and dropping the database on that reading
    # tears a live server down (SME-186 review 1, finding 2).
    echo "$scratch_url" >"$scratch_file"
    : >"$SQLX_CALLS"
    : >"$CLEANUP_CALLS"
    out=$(check_server status)
    grep -q "^not running" <<<"$out" || fail "$name: status says '$out', not not running"
    out=$(check_server stop)
    rc=$?
    # A refusal is not a stop. Exit 3, so that a caller chaining
    # `scripts/check-server stop && rm -rf "$worktree"` can tell "it stopped"
    # from "it touched nothing because it couldn't tell the group apart"
    # (SME-186 review 2, finding 1).
    [ "$rc" = 3 ] || fail "$name: stop exited $rc, not 3 for a live group it refused to signal: $out"
    grep -qF "process group $pgid" <<<"$out" || fail "$name: stop doesn't name the group: $out"
    grep -q "isn't this worktree's check server" <<<"$out" || fail "$name: stop doesn't say whose group it isn't: $out"
    pid_is_live "$pgid" || fail "$name: stop signalled the group the pid file named"
    [ "$(cat "$pid_file")" = "$pgid" ] ||
        fail "$name: stop cleared the pid file naming live group $pgid: '$(cat "$pid_file")'"
    [ "$(cat "$scratch_file")" = "$scratch_url" ] ||
        fail "$name: stop emptied the scratch record while a live group may be serving it: '$(cat "$scratch_file")'"
    grep -q "database drop" "$SQLX_CALLS" &&
        fail "$name: stop dropped the scratch database under a live group: $(cat "$SQLX_CALLS")"
    [ -s "$CLEANUP_CALLS" ] &&
        fail "$name: stop ran the sandbox cleanup for a group it didn't stop: $(cat "$CLEANUP_CALLS")"
    # And the start that follows isn't held by a group it must not touch.
    out=$(check_server start HEAD) || fail "$name: start after a stale pid file: $out"
    grep -q "check server up" <<<"$out" || fail "$name: start after a stale pid file didn't come up: $out"
    check_server stop >/dev/null
    kill_helper "$pgid"
}
other_port=$(free_port) || fail "G3: no free port for the other lock"
for group_dir_name in own-dir other-lock in-worktree; do
    [ "$group_dir_name" = in-worktree ] && group_dir=$worktree ||
        { mkdir -p "$dir/$group_dir_name"; group_dir=$dir/$group_dir_name; }
    lock=""
    [ "$group_dir_name" = other-lock ] && lock=$SMELT_LOCK_DIR/smelt-check-server-$other_port.lock
    stale_pid_group_case "G3 ($group_dir_name)" "$group_dir" "$lock"
done

# G3b (SME-186 review 1, finding 2): the group the pid file names really is
# this worktree's server, and its lock file has been unlinked — what
# "clearing a stuck lock" does. A rename moves the inode, so the holder keeps
# holding it and /proc/<pid>/fd reads `… (deleted)`, which the exact-name
# pattern missed: status called a live server "not running", start would
# have joined it on the port it still holds, and stop's answer was to empty
# the pid file and drop the database underneath it. status must still see
# the server, and stop must still stop it properly.
check_server stop >/dev/null
start_group "$worktree" "$dir/g3b-ready" "$port_lock"
pgid_b=$(cat "$dir/g3b-ready")
echo "$pgid_b" >"$pid_file"
echo "$scratch_url" >"$scratch_file"
: >"$SQLX_CALLS"
: >"$CLEANUP_CALLS"
# Unlink for real: a rename in the same filesystem would just move the name
# the descriptors read. mv onto tmpfs copies and frees the original, leaving
# the holders' descriptors reading `… (deleted)` — and it moves the file
# rather than removing it, as this script's rules ask.
mv "$port_lock" "/dev/shm/sme186-guards-g3b-lock.$$"
out=$(check_server status)
grep -q "^running (process group $pgid_b)" <<<"$out" ||
    fail "G3b: status doesn't see the server whose lock file was unlinked: $out"
out=$(check_server stop)
grep -qF "stopped the check server (process group $pgid_b" <<<"$out" ||
    fail "G3b: stop didn't stop the server whose lock file was unlinked: $out"
! pid_is_live "$pgid_b" || fail "G3b: the group is still alive after stop"
[ -s "$pid_file" ] && fail "G3b: stop left the pid file set: '$(cat "$pid_file")'"
[ -s "$scratch_file" ] && fail "G3b: stop left the scratch record set: '$(cat "$scratch_file")'"
grep -q "database drop" "$SQLX_CALLS" ||
    fail "G3b: stop didn't drop the scratch database of the server it stopped: $(cat "$SQLX_CALLS")"
[ -s "$CLEANUP_CALLS" ] || fail "G3b: stop didn't run the sandbox cleanup: '$(cat "$CLEANUP_CALLS")'"

# G4 (SME-186 B41): the default check worktree is named after this checkout, so
# two checkouts never share one server's pid file, port lock and scratch
# database name — one's `stop` would be another's server. `status` reads the
# paths and writes nothing, so this can ask the real script with the variable
# unset.
repo_root=$(git rev-parse --show-toplevel)
if [ -w "$repo_root/.." ]; then
    want_worktree=$repo_root/../smelt-check-$(basename "$repo_root")
else
    want_worktree=${TMPDIR:-/tmp}/smelt-check-$(basename "$repo_root")
fi
out=$(env -u CHECK_WORKTREE PATH="$dir/bin:$PATH" \
    SANDBOX_IMAGE_IMPORT="$dir/bin/import" SANDBOX_INSTANCE_CLEANUP="$dir/bin/cleanup" \
    CHECK_PORT="$port" scripts/check-server status 2>&1)
grep -qF "log: $want_worktree/.check-server.log" <<<"$out" ||
    fail "G4: the default worktree is not this checkout's: '$out', expected it to name $want_worktree"

# G5 (SME-186 B40): the scratch database's URL is built from what dotenvy
# would load, not from what `sed | tail` finds. The dev .env's DATABASE_URL is
# unquoted and holds a `$`, which dotenvy substitutes and sed does not; and
# dotenvy keeps the first line that sets a name, where `tail -n 1` kept the
# last. The environment's DATABASE_URL is unset here, so .env is what's read.
env_file=$worktree/.env
pw_value=pw7value
printf 'export DATABASE_URL="postgres://u:${PW}@localhost/smelt_dev"\nDATABASE_URL=postgres://u@elsewhere/x\n' >"$env_file"
dotenv_url=postgres://u:${pw_value}@localhost/smelt_scratch_worktree
: >"$SQLX_CALLS"
extra_env=(DATABASE_URL= PW="$pw_value")
if ! out=$(CHECK_SCRATCH_DB=1 check_server start HEAD); then
    fail "G5: start: $out"
fi
extra_env=()
grep -qx "database create --database-url $dotenv_url" "$SQLX_CALLS" ||
    fail "G5: start created a database dotenvy wouldn't have named ($dotenv_url): $(cat "$SQLX_CALLS")"
[ "$(cat "$scratch_file" 2>/dev/null)" = "$dotenv_url" ] ||
    fail "G5: start recorded '$(cat "$scratch_file" 2>/dev/null)', not $dotenv_url"
check_server stop >/dev/null
[ "$(tail -n 1 "$SQLX_CALLS")" = "database drop -y --database-url $dotenv_url" ] ||
    fail "G5: stop didn't drop the database start created: $(cat "$SQLX_CALLS")"
: >"$env_file"

# G6 (SME-186 review 2, finding 2): one read of the .env per setting, not one per
# question about it. effective_value asked effective_source — whose .env arm parses
# the file to decide — and then parsed it again for the value, so a start
# (SANDBOX_IMAGE, RUST_LOG, NO_COLOR…) paid for several python3 launches to answer
# one question. The counter is a python3 of the test's own, first on PATH: it
# records each call and runs the real reader, so the values stay dotenvy's and only
# the count is what's under test.
count_bin=$dir/count-bin
mkdir -p "$count_bin"
py_calls=$dir/python-calls
cat >"$count_bin/python3" <<EOF
#!/usr/bin/env bash
echo "\$*" >>"$py_calls"
exec "$STUB_PYTHON3" "\$@"
EOF
chmod +x "$count_bin/python3"
# How many times the .env was parsed for one name (the reader's last argument).
parses_for() { grep -c " $1\$" "$py_calls" || true; }
# start with the stubs, as the lib's check_server() runs it, but with the counting
# python3 first on PATH. The VAR=value arguments come last, so they win.
g6_start() {
    env -u SANDBOX_IMAGE -u RUST_LOG -u NO_COLOR \
        SANDBOX_IMAGE_IMPORT="$dir/bin/import" SANDBOX_INSTANCE_CLEANUP="$dir/bin/cleanup" \
        CHECK_WORKTREE="$worktree" DATABASE_URL=postgres://u@localhost/smelt_dev \
        CHECK_PORT="$port" PATH="$count_bin:$dir/bin:$PATH" "$@" \
        timeout 90 scripts/check-server start HEAD 2>&1
}
printf 'SANDBOX_IMAGE=smelt-sandbox:g6\nRUST_LOG=debug\n' >"$env_file"
: >"$py_calls"
out=$(g6_start)
rc=$?
[ "$rc" = 0 ] || fail "G6: start with a .env that answers: $out"
grep -q "logging at RUST_LOG=debug (from .env)" <<<"$out" ||
    fail "G6: the level read from .env isn't the one start used: $out"
[ "$(parses_for RUST_LOG)" = 1 ] ||
    fail "G6: RUST_LOG read the .env $(parses_for RUST_LOG) times, not once — its value and its source are the same question: $(cat "$py_calls")"
[ "$(parses_for SANDBOX_IMAGE)" = 1 ] ||
    fail "G6: SANDBOX_IMAGE read the .env $(parses_for SANDBOX_IMAGE) times, not once: $(cat "$py_calls")"
check_server stop >/dev/null
# And where the environment settles a name, the file isn't read for it at all.
: >"$py_calls"
out=$(g6_start RUST_LOG=info)
rc=$?
[ "$rc" = 0 ] || fail "G6: start with RUST_LOG in the environment: $out"
grep -q "logging at RUST_LOG=info (yours)" <<<"$out" ||
    fail "G6: the environment's RUST_LOG wasn't used as given: $out"
[ "$(parses_for RUST_LOG)" = 0 ] ||
    fail "G6: the .env was read for RUST_LOG though the environment settles it: $(cat "$py_calls")"
check_server stop >/dev/null
: >"$env_file"

# G7 (SME-186 review 2, finding 3): browser_check_cache left its loop variable in
# check-server's shell. Nothing reads `dir` today, so the helper asks from outside:
# this script has a `dir` of its own, which would hide the leak.
cat >"$dir/check-dir-local.sh" <<'EOF'
#!/usr/bin/env bash
# browser_check_cache must not leave `dir` set in the shell that called it.
# Usage: check-dir-local.sh REPO WORKTREE
repo=$1 worktree=$2
. "$repo/scripts/lib/check-server-config.sh"
browser_check_cache >/dev/null 2>&1
[ -z "${dir+x}" ] || echo "dir=$dir"
EOF
chmod +x "$dir/check-dir-local.sh"
leaked=$("$dir/check-dir-local.sh" "$PWD" "$worktree")
[ -z "$leaked" ] ||
    fail "G7: browser_check_cache left its loop variable behind in its caller: $leaked"

# G8 (SME-226): the two database settings accept exactly 1, and asking for both
# databases at once is refused. Until now any value of CHECK_SCRATCH_DB but `1`
# — `0` among them — meant the dev database as silently as `true` did, which is
# how SME-175's hand-run start ended up serving it. A bad value exits 2 where
# CHECK_PORT and CHECK_PORT_WAIT do, before anything is locked, checked out,
# created or signalled; the two flags together is a refusal, so exit 1.
refused_database_flag() { # name want setting value
    local name=$1 want=$2 setting=$3 value=$4 out rc
    check_server stop >/dev/null
    : >"$SQLX_CALLS"
    : >"$pid_file"
    : >"$scratch_file"
    extra_env=("$setting=$value")
    out=$(check_server start HEAD)
    rc=$?
    extra_env=()
    [ "$rc" = "$want" ] || fail "$name: start with $setting='$value' exited $rc, not $want: $out"
    grep -qF "$setting" <<<"$out" || fail "$name: the refusal doesn't name $setting: $out"
    grep -q "check server up" <<<"$out" && fail "$name: start came up anyway: $out"
    [ -s "$SQLX_CALLS" ] && fail "$name: a refused start called sqlx: $(cat "$SQLX_CALLS")"
    [ -s "$pid_file" ] && fail "$name: a refused start wrote a pid file: '$(cat "$pid_file")'"
    [ -s "$scratch_file" ] && fail "$name: a refused start wrote a scratch file: '$(cat "$scratch_file")'"
    flock -n "$port_lock" true || fail "$name: a refused start took the port lock"
}
for setting in CHECK_DEV_DB CHECK_SCRATCH_DB; do
    for value in 0 2 true "1 "; do
        refused_database_flag "G8 ($setting='$value')" 2 "$setting" "$value"
    done
done

# Both at once: one asks for the dev database, the other for the scratch one
# that is the default, so they disagree — a refusal (1), not a bad value (2),
# and it names both.
check_server stop >/dev/null
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"
extra_env=(CHECK_DEV_DB=1 CHECK_SCRATCH_DB=1)
out=$(check_server start HEAD)
rc=$?
extra_env=()
[ "$rc" = 1 ] || fail "G8 (both flags): start exited $rc, not 1: $out"
grep -qF "CHECK_DEV_DB" <<<"$out" || fail "G8 (both flags): the refusal doesn't name CHECK_DEV_DB: $out"
grep -qF "CHECK_SCRATCH_DB" <<<"$out" || fail "G8 (both flags): the refusal doesn't name CHECK_SCRATCH_DB: $out"
[ -s "$SQLX_CALLS" ] && fail "G8 (both flags): the refused pair called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$pid_file" ] && fail "G8 (both flags): the refused pair wrote a pid file: '$(cat "$pid_file")'"
[ -s "$scratch_file" ] && fail "G8 (both flags): the refused pair wrote a scratch file: '$(cat "$scratch_file")'"
flock -n "$port_lock" true || fail "G8 (both flags): the refused pair took the port lock"
# The old flag alone is still accepted: it is the default now (question 2's
# answer), so the docs and runbooks that set it keep working.
check_server stop >/dev/null

finish
