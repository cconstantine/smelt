#!/usr/bin/env bash
# Checks that the scripts a session runs for the gate and for hands-on
# checks delete no files (SME-107), and scripts/check-server's state files:
# emptied rather than removed, an empty one meaning "not running" or "no
# scratch database"; and the locks (SME-100): scripts/with-cluster-lock,
# what check.sh, browser-tier, cluster-test and clean-test-namespace.sh run
# under the cluster lock, and check-server's port lock. Needs no cluster or
# database: cargo, dx, sqlx, curl, python3 and the image check are stubs,
# and every lock lives under target/test-check-scripts/locks
# (SMELT_LOCK_DIR), never the real one. Claude Code's safety check refuses
# a command whose scripts remove files, so this keeps everything it writes, under
# target/test-check-scripts, overwritten on the next run.
#
#   scripts/test-check-scripts
set -uo pipefail
cd "$(dirname "$0")/.."

failures=0
fail() {
    echo "FAIL: $*" >&2
    failures=$((failures + 1))
}

# None of the scripts the gate or a hands-on check runs removes a file.
for script in scripts/check-server scripts/browser-tier scripts/check.sh scripts/lint-expects scripts/build-sandbox-image.sh \
    scripts/with-cluster-lock scripts/cluster-test scripts/clean-test-namespace.sh; do
    if found=$(grep -nE '(^|[^[:alnum:]_-])(rm|rmdir|unlink|shred)([[:space:]]|$)|-delete([[:space:]]|$)' "$script" | grep -vE '^[0-9]+:[[:space:]]*#'); then
        fail "$script removes files: $found"
    fi
done

dir=$PWD/target/test-check-scripts
mkdir -p "$dir/bin"

# Every lock these scripts take goes here, never the real cluster lock
# (SME-100): another session's gate may hold that one.
export SMELT_LOCK_DIR=$dir/locks
mkdir -p "$SMELT_LOCK_DIR"
lock=$SMELT_LOCK_DIR/smelt-cluster.lock
lock_log=$SMELT_LOCK_DIR/smelt-cluster-lock.log
: >"$lock_log"
# Whether the cluster lock is free: a fresh open and a non-blocking flock,
# which fails while any other open of the file holds it.
lock_is_free() { flock -n "$lock" true; }
# Waits up to 10 s for the cluster lock to be taken.
wait_until_held() {
    for _ in $(seq 1 100); do
        lock_is_free || return 0
        sleep 0.1
    done
    return 1
}

# Each stub below that the gate scripts call appends a line to $CALLS (when
# set): its arguments, then "locked" or "unlocked", whether another process
# held the cluster lock at the time (SME-100).
cat >"$dir/bin/lock-state" <<'EOF'
#!/usr/bin/env bash
flock -n "$SMELT_LOCK_DIR/smelt-cluster.lock" true && echo unlocked || echo locked
EOF
# cargo: records each call. A test run (not --no-run) prints a result line.
# CARGO_FAIL: a pattern; a call whose arguments match it fails.
cat >"$dir/bin/cargo" <<'EOF'
#!/usr/bin/env bash
echo "cargo $* $(lock-state)" >>"$CALLS"
if [ -n "${CARGO_FAIL:-}" ] && [[ "$*" =~ $CARGO_FAIL ]]; then
    echo "error: stub cargo told to fail"
    exit 101
fi
if [ "$1" = test ] && [[ " $* " != *" --no-run "* ]]; then
    echo "test result: ok. 1 passed; 0 failed"
fi
exit 0
EOF
# dx serve: runs until stopped, like the real one. It first records the
# log settings it was started with (the server it runs inherits them) and
# writes a line of its own to the log. dx build records the call and ends.
cat >"$dir/bin/dx" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = build ]; then
    echo "dx $* $(lock-state)" >>"$CALLS"
    exit 0
fi
echo "stub dx started as $$"
printf 'RUST_LOG=%s\nNO_COLOR=%s\n' "${RUST_LOG-<unset>}" "${NO_COLOR-<unset>}" >"$DX_ENV.tmp"
mv "$DX_ENV.tmp" "$DX_ENV"
exec sleep 600
EOF
# sqlx: records each call, one per line.
cat >"$dir/bin/sqlx" <<'EOF'
#!/usr/bin/env bash
echo "$*" >>"$SQLX_CALLS"
[ -n "${CALLS:-}" ] && echo "sqlx $* $(lock-state)" >>"$CALLS"
exit 0
EOF
# curl: the server is up at once.
cat >"$dir/bin/curl" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
# The image check: the cluster has it.
cat >"$dir/bin/import" <<'EOF'
#!/usr/bin/env bash
[ -n "${CALLS:-}" ] && echo "import $(lock-state)" >>"$CALLS"
exit 0
EOF
chmod +x "$dir/bin/lock-state" "$dir/bin/cargo" "$dir/bin/dx" "$dir/bin/sqlx" "$dir/bin/curl" "$dir/bin/import"

# The check worktree: a clone sharing this repo's objects, so it can check
# out any commit here without registering a worktree. Reused across runs.
worktree=$dir/worktree
[ -d "$worktree/.git" ] || git clone -q --shared --no-checkout "$PWD" "$worktree" || exit 1

export SQLX_CALLS=$dir/sqlx-calls
export DX_ENV=$dir/dx-env
pid_file=$worktree/.check-server.pid
scratch_file=$worktree/.check-server.scratch-db
log_file=$worktree/.check-server.log
# Extra VAR=VALUE settings for check_server's environment, set per case.
extra_env=()
# The caller's own RUST_LOG and NO_COLOR are dropped, so they can't change
# the results.
check_server() {
    env -u SANDBOX_IMAGE -u RUST_LOG -u NO_COLOR PATH="$dir/bin:$PATH" CHECK_WORKTREE="$worktree" \
        SANDBOX_IMAGE_IMPORT="$dir/bin/import" DATABASE_URL=postgres://u@localhost/smelt_dev \
        "${extra_env[@]}" scripts/check-server "$@" 2>&1
}
scratch_url=postgres://u@localhost/smelt_scratch_worktree

# Whatever an earlier, failed run left running.
check_server stop >/dev/null
: >"$SQLX_CALLS"

# A scratch database for a ref without SME-115's fix is refused: that
# server's sweep deletes the dev server's sandbox claims. It creates no
# database, writes no state file and starts nothing.
old_ref=$(git rev-list --max-parents=0 HEAD | tail -n 1)
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"
if out=$(CHECK_SCRATCH_DB=1 check_server start "$old_ref"); then
    fail "start with CHECK_SCRATCH_DB=1 for a ref without the fix succeeded: $out"
fi
grep -q "SME-115" <<<"$out" || fail "the refusal doesn't name SME-115: $out"
grep -q "$old_ref" <<<"$out" || fail "the refusal doesn't name the ref: $out"
[ -s "$SQLX_CALLS" ] && fail "a refused start called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$pid_file" ] && fail "a refused start wrote a pid file: '$(cat "$pid_file")'"
[ -s "$scratch_file" ] && fail "a refused start wrote a scratch file: '$(cat "$scratch_file")'"
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status after a refused start: $(check_server status)"

# The same for a commit of SME-115's own branch that has the instance
# migration but not yet the fix (its sweep isn't scoped yet).
: >"$SQLX_CALLS"
if out=$(CHECK_SCRATCH_DB=1 check_server start 7dc5248); then
    fail "start with CHECK_SCRATCH_DB=1 for a commit partway through the fix succeeded: $out"
fi
grep -q "SME-115" <<<"$out" || fail "the partway refusal doesn't name SME-115: $out"
[ -s "$SQLX_CALLS" ] && fail "a refused partway start called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$scratch_file" ] && fail "a refused partway start wrote a scratch file: '$(cat "$scratch_file")'"

# start with a scratch database, for a ref with the fix: both state files
# written.
if ! out=$(CHECK_SCRATCH_DB=1 check_server start HEAD); then
    fail "start: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && pgrep -g "$pgid" >/dev/null || fail "after start, the pid file names no live group: '$pgid'"
[ "$(cat "$scratch_file" 2>/dev/null)" = "$scratch_url" ] || fail "after start, the scratch file holds '$(cat "$scratch_file" 2>/dev/null)'"
grep -qx "database create --database-url $scratch_url" "$SQLX_CALLS" || fail "start didn't create the scratch database: $(cat "$SQLX_CALLS")"
case "$(check_server status)" in running*) ;; *) fail "status after start: $(check_server status)" ;; esac

# stop: the group gone, the database dropped, both files kept and empty.
: >"$SQLX_CALLS"
out=$(check_server stop)
[ -n "$pgid" ] && pgrep -g "$pgid" >/dev/null && fail "after stop, group $pgid is still running"
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "stop didn't drop the scratch database: $(cat "$SQLX_CALLS")"
for file in "$pid_file" "$scratch_file"; do
    if [ ! -e "$file" ]; then
        fail "stop removed $(basename "$file")"
    elif [ -s "$file" ]; then
        fail "after stop, $(basename "$file") holds '$(cat "$file")'"
    fi
done

# start without a scratch database: the pid file written, no scratch file.
if ! out=$(check_server start HEAD); then
    fail "start: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && pgrep -g "$pgid" >/dev/null || fail "after start, the pid file names no live group: '$pgid'"
[ -s "$scratch_file" ] && fail "a start without CHECK_SCRATCH_DB left '$(cat "$scratch_file")' to drop"
case "$(check_server status)" in running*) ;; *) fail "status after start: $(check_server status)" ;; esac

# stop: the group gone, nothing to drop, both files kept and empty.
: >"$SQLX_CALLS"
out=$(check_server stop)
[ -n "$pgid" ] && pgrep -g "$pgid" >/dev/null && fail "after stop, group $pgid is still running"
[ -s "$SQLX_CALLS" ] && fail "stop with no scratch database called sqlx: $(cat "$SQLX_CALLS")"
for file in "$pid_file" "$scratch_file"; do
    if [ ! -e "$file" ]; then
        fail "stop removed $(basename "$file")"
    elif [ -s "$file" ]; then
        fail "after stop, $(basename "$file") holds '$(cat "$file")'"
    fi
done
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status after stop: $(check_server status)"

# stop again: nothing running, nothing to drop.
: >"$SQLX_CALLS"
out=$(check_server stop)
grep -q "no check server running" <<<"$out" || fail "a second stop said: $out"
[ -s "$SQLX_CALLS" ] && fail "a second stop called sqlx: $(cat "$SQLX_CALLS")"

# A crashed run: a pid file naming a dead group, and a scratch database
# never dropped. status says not running, stop drops the database, and a
# start goes ahead.
dead=$(bash -c 'echo $$')
echo "$dead" >"$pid_file"
echo "$scratch_url" >"$scratch_file"
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status with a dead pid: $(check_server status)"
: >"$SQLX_CALLS"
check_server stop >/dev/null
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "stop after a crash didn't drop the scratch database: $(cat "$SQLX_CALLS")"
[ -e "$pid_file" ] && [ ! -s "$pid_file" ] || fail "stop after a crash didn't leave an empty pid file"
echo "$dead" >"$pid_file"
if ! out=$(check_server start HEAD); then
    fail "start over a dead pid: $out"
fi
check_server stop >/dev/null

# The log level and colour the server gets (SME-117). Each case starts a
# check server with extra_env and the given start arguments, then compares
# what the stub dx recorded, and the level start printed, with what's
# expected; then stops it. An empty value counts as unset everywhere, since
# smelt reads an empty RUST_LOG as errors only.
dx_env_after_start() {
    for _ in $(seq 1 50); do
        [ -s "$DX_ENV" ] && break
        sleep 0.1
    done
    cat "$DX_ENV" 2>/dev/null
}
expect_log_settings() { # name rust_log no_color printed [start args...]
    local name=$1 rust_log=$2 no_color=$3 printed=$4 out got
    shift 4
    : >"$DX_ENV"
    if ! out=$(check_server start HEAD "$@"); then
        fail "$name: start: $out"
    fi
    got=$(dx_env_after_start)
    [ "$got" = "$(printf 'RUST_LOG=%s\nNO_COLOR=%s' "$rust_log" "$no_color")" ] ||
        fail "$name: the server got: $(tr '\n' ' ' <<<"$got")"
    grep -qF "RUST_LOG=$rust_log ($printed)" <<<"$out" || fail "$name: start printed: $out"
    check_server stop >/dev/null
    extra_env=()
}
env_file=$worktree/.env
: >"$env_file"
expect_log_settings "no level anywhere" info 1 "check-server's default"
extra_env=(RUST_LOG=debug)
expect_log_settings "a level in the environment" debug 1 yours
extra_env=(RUST_LOG=)
expect_log_settings "an empty level in the environment" info 1 "check-server's default"
echo "RUST_LOG=warn" >"$env_file"
expect_log_settings "a level in .env" warn 1 "from .env"
# Written the ways dotenvy also reads: spaces around =, a comment after.
echo "RUST_LOG = warn" >"$env_file"
expect_log_settings "a level in .env with spaces around =" warn 1 "from .env"
echo "RUST_LOG=warn # quieter" >"$env_file"
expect_log_settings "a level in .env with a comment after it" warn 1 "from .env"
echo 'RUST_LOG="warn # not a comment"' >"$env_file"
expect_log_settings "a quoted level in .env keeps its #" "warn # not a comment" 1 "from .env"
# An empty value with a comment after it is empty to dotenvy, so the
# default applies (SME-117 review 2).
echo "RUST_LOG= # debug when needed" >"$env_file"
expect_log_settings "an empty level in .env with a comment" info 1 "check-server's default"
# dotenvy keeps the first line that sets a name (SME-117 review 2).
printf 'RUST_LOG=debug\nRUST_LOG=warn\n' >"$env_file"
expect_log_settings "a level set twice in .env" debug 1 "from .env"
# dotenvy never overrides a variable that's set, even to "", so an empty
# one in the environment would hide .env's from smelt.
echo "RUST_LOG=warn" >"$env_file"
extra_env=(RUST_LOG=)
expect_log_settings "a level in .env under an empty one in the environment" warn 1 "from .env"
: >"$env_file"
extra_env=(RUST_LOG=debug)
expect_log_settings "an override over the environment" trace 1 yours -- RUST_LOG=trace
extra_env=(RUST_LOG=debug)
expect_log_settings "an empty override" debug 1 yours -- RUST_LOG=
expect_log_settings "an empty override and nothing else" info 1 "check-server's default" -- RUST_LOG=
extra_env=(NO_COLOR=yes)
expect_log_settings "NO_COLOR in the environment" info yes "check-server's default"
expect_log_settings "NO_COLOR as an override" info no "check-server's default" -- NO_COLOR=no
: >"$env_file"

# A second start keeps the first run's log as .check-server.log.prev, and
# stop and status name the log.
: >"$DX_ENV"
check_server start HEAD >/dev/null || fail "first start for the log"
dx_env_after_start >/dev/null
first_log=$(cat "$log_file")
grep -q "stub dx started" <<<"$first_log" || fail "the first run's log holds: $first_log"
out=$(check_server status)
grep -qF "$log_file" <<<"$out" || fail "status doesn't name the log: $out"
out=$(check_server stop)
grep -qF "$log_file" <<<"$out" || fail "stop doesn't name the log: $out"
: >"$DX_ENV"
check_server start HEAD >/dev/null || fail "second start for the log"
dx_env_after_start >/dev/null
[ "$(cat "$log_file.prev" 2>/dev/null)" = "$first_log" ] ||
    fail "after a second start, .check-server.log.prev holds: $(cat "$log_file.prev" 2>/dev/null)"
[ "$(cat "$log_file")" != "$first_log" ] || fail "the second start didn't empty the log"
check_server stop >/dev/null
out=$(check_server status)
grep -qF "$log_file" <<<"$out" || fail "status when stopped doesn't name the log: $out"

# scripts/with-cluster-lock (SME-100). Every wait is bounded with timeout,
# so a deadlock fails a case rather than hanging the run.

# 1. The lock is held for the command, and only for it; its exit status
# comes back.
out=$(timeout 20 scripts/with-cluster-lock bash -c 'flock -n "$1" true && echo free || echo held' _ "$lock" 2>&1)
[ "$out" = held ] || fail "with-cluster-lock: during the command the lock was: $out"
lock_is_free || fail "with-cluster-lock: the lock is still held after the command"
timeout 20 scripts/with-cluster-lock true || fail "with-cluster-lock true exited $?"
timeout 20 scripts/with-cluster-lock bash -c 'exit 3'
rc=$?
[ "$rc" = 3 ] || fail "with-cluster-lock didn't pass on the command's exit status 3: $rc"

# 2. A second run waits, naming the holder, and runs once the first ends.
gate=$dir/lock-gate b_out=$dir/lock-b-out b_err=$dir/lock-b-err
: >"$gate"
: >"$b_out"
# Not under timeout: $! must be with-cluster-lock's own pid, the holder.
# Each command bounds itself instead.
scripts/with-cluster-lock bash -c 'for _ in $(seq 1 300); do [ -s "$1" ] && exit 0; sleep 0.1; done; exit 1' _ "$gate" 2>/dev/null &
a=$!
wait_until_held || fail "with-cluster-lock: run A never took the lock"
scripts/with-cluster-lock bash -c 'echo ran >"$1"' _ "$b_out" 2>"$b_err" &
b=$!
sleep 1
grep -q "waiting for the cluster lock (held by pid $a" "$b_err" ||
    fail "with-cluster-lock: run B didn't say it waits for pid $a: $(cat "$b_err")"
[ -s "$b_out" ] && fail "with-cluster-lock: run B ran while A held the lock"
echo go >"$gate"
wait "$a" || fail "with-cluster-lock: run A failed"
wait "$b" || fail "with-cluster-lock: run B failed"
[ -s "$b_out" ] || fail "with-cluster-lock: run B never ran after A finished"

# 3. Re-entry: under an old outer flock it runs inside that lock, with a
# notice; inside itself, silently.
if ! out=$(timeout 10 flock "$lock" scripts/with-cluster-lock true 2>&1); then
    fail "with-cluster-lock under an outer flock didn't finish (deadlock?): $out"
fi
grep -q "drop the outer flock" <<<"$out" || fail "with-cluster-lock under an outer flock printed no notice: $out"
if ! out=$(timeout 10 scripts/with-cluster-lock scripts/with-cluster-lock true 2>&1); then
    fail "with-cluster-lock inside itself didn't finish (deadlock?): $out"
fi
[ -z "$out" ] || fail "with-cluster-lock inside itself printed: $out"

# The descriptor form of an outer lock (`exec 9>>LOCK; flock 9`): the
# short-lived `flock 9` that took it has exited, so /proc/locks doesn't
# list it, yet the descriptor this script inherits holds it (SME-100
# review 1). It re-enters rather than deadlocking.
if ! out=$( (flock 9 && timeout 10 scripts/with-cluster-lock true) 9>>"$lock" 2>&1); then
    fail "with-cluster-lock under a descriptor-form outer flock didn't finish (deadlock?): $out"
fi
grep -q "drop the outer flock" <<<"$out" || fail "with-cluster-lock under a descriptor-form outer flock printed no notice: $out"
# And a lock held that way by an unrelated process: it says it waits, though
# /proc/locks names no holder.
(flock 9 && sleep 3) 9>>"$lock" &
outer=$!
wait_until_held || fail "the descriptor-form holder never took the lock"
out=$(timeout 2 scripts/with-cluster-lock true 2>&1)
rc=$?
wait "$outer"
[ "$rc" = 124 ] || fail "with-cluster-lock didn't wait for a descriptor-form holder (exit $rc): $out"
grep -q "waiting for the cluster lock" <<<"$out" || fail "with-cluster-lock waited silently for a holder /proc/locks doesn't list: $out"

# 4. Something the command leaves running doesn't keep the lock.
bg=$(timeout 20 scripts/with-cluster-lock bash -c 'sleep 30 >/dev/null 2>&1 & echo $!')
if [ -n "$bg" ] && kill -0 "$bg" 2>/dev/null; then
    lock_is_free || fail "with-cluster-lock: a background child of the command kept the lock"
    kill "$bg"
else
    fail "with-cluster-lock: the background sleep isn't running: '$bg'"
fi

# 5. A killed holder frees the lock, and never while its command still
# runs: the holder's pid is the one the waiting line names, so a kill of
# that pid alone must not let a second run onto the cluster beside the
# first (SME-100 review 1). SIGKILL takes the command with it; TERM is
# passed on to the command and its children, and the lock is freed once
# they're gone.
child_pid=$dir/lock-child-pid grandchild_pid=$dir/lock-grandchild-pid
alive() { [ -s "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
: >"$child_pid"
scripts/with-cluster-lock bash -c 'echo $$ >"$1"; exec sleep 30' _ "$child_pid" &
holder=$!
wait_until_held || fail "with-cluster-lock: the holder to kill never took the lock"
for _ in $(seq 1 50); do [ -s "$child_pid" ] && break; sleep 0.1; done
kill -9 "$holder"
wait "$holder" 2>/dev/null
for _ in $(seq 1 50); do lock_is_free && break; sleep 0.1; done
lock_is_free || fail "with-cluster-lock: the lock is still held after its holder was killed"
alive "$child_pid" && fail "with-cluster-lock: the lock came free after kill -9 of its holder while the command still ran"
alive "$child_pid" && kill "$(cat "$child_pid")"
: >"$child_pid"
: >"$grandchild_pid"
scripts/with-cluster-lock bash -c 'echo $$ >"$1"; sleep 30 & echo $! >"$2"; wait' _ "$child_pid" "$grandchild_pid" &
holder=$!
wait_until_held || fail "with-cluster-lock: the holder to TERM never took the lock"
for _ in $(seq 1 50); do [ -s "$grandchild_pid" ] && break; sleep 0.1; done
kill -TERM "$holder"
for _ in $(seq 1 100); do lock_is_free && break; sleep 0.1; done
lock_is_free || fail "with-cluster-lock: the lock is still held 10 s after its holder got TERM"
alive "$child_pid" && fail "with-cluster-lock: the lock came free after TERM to its holder while the command still ran"
alive "$grandchild_pid" && fail "with-cluster-lock: TERM to the holder left the command's child running"
wait "$holder" 2>/dev/null
for f in "$child_pid" "$grandchild_pid"; do alive "$f" && kill "$(cat "$f")"; done

# Its usage text, with no command, is the whole header.
header_end=$(awk '/^set -uo pipefail/ { print prev; exit } { prev = $0 }' scripts/with-cluster-lock | sed 's/^# \{0,1\}//')
[ "$(scripts/with-cluster-lock 2>&1 | tail -n 1)" = "$header_end" ] || fail "with-cluster-lock's usage stops before the header's last line: $header_end"

# 6. The log: a line per run with its wait, hold, status and worktree, and
# re-entered runs marked.
grep -E "waited=[0-9]+ held=[0-9]+ exit=3 worktree=$PWD " "$lock_log" >/dev/null ||
    fail "with-cluster-lock's log has no line for the exit-3 run: $(cat "$lock_log")"
grep -E "reentered held=[0-9]+ exit=0 worktree=$PWD " "$lock_log" >/dev/null ||
    fail "with-cluster-lock's log has no re-entered line: $(cat "$lock_log")"

# 13. --output: the command's output goes to the file, the waiting line
# doesn't; and the lock is found from the script's own checkout, not the
# caller's directory.
out_file=$dir/lock-output out_err=$dir/lock-output-err
: >"$out_file"
timeout 30 flock "$lock" sleep 2 &
outer=$!
wait_until_held || fail "--output: the outer holder never took the lock"
(cd / && timeout 30 "$OLDPWD/scripts/with-cluster-lock" --output "$out_file" bash -c 'echo hello; echo oops >&2') 2>"$out_err" ||
    fail "with-cluster-lock --output failed: $(cat "$out_err")"
wait "$outer"
[ "$(cat "$out_file")" = "$(printf 'hello\noops')" ] || fail "--output wrote: $(cat "$out_file")"
grep -q "waiting for the cluster lock" "$out_err" || fail "--output: no waiting line on stderr: $(cat "$out_err")"
grep -q "waiting" "$out_file" && fail "--output: the waiting line went into the output file"
# A repository of its own: with SMELT_LOCK_DIR unset, the lock is its git
# common dir's, wherever it's run from.
fake=$dir/fake-repo
[ -d "$fake/.git" ] || git init -q "$fake"
mkdir -p "$fake/scripts"
cp scripts/with-cluster-lock "$fake/scripts/with-cluster-lock"
out=$(cd / && env -u SMELT_LOCK_DIR timeout 20 "$fake/scripts/with-cluster-lock" bash -c 'flock -n "$1" true && echo free || echo held' _ "$fake/.git/smelt-cluster.lock" 2>&1)
[ "$out" = held ] || fail "with-cluster-lock run from / didn't lock its own repository's lock: $out"

# The gate scripts with stubs for cargo, dx, sqlx and the image check: what
# runs before the lock, and what under it. They write their logs to this
# checkout's target/check and target/browser-tier, as a real run does.
export CALLS=$dir/calls
gate_env=(env -u SANDBOX_IMAGE -u CARGO_FAIL PATH="$dir/bin:$PATH" SANDBOX_IMAGE_IMPORT="$dir/bin/import"
    DATABASE_URL=postgres://u@localhost/smelt_dev BROWSER_CHECK_CACHE="$dir")
# Never the real cargo or dx: that would build, and run the real tests.
for tool in cargo dx sqlx; do
    [ "$("${gate_env[@]}" bash -c "command -v $tool")" = "$dir/bin/$tool" ] || {
        echo "the $tool stub isn't first on PATH; stopping before running any gate script" >&2
        exit 1
    }
done
wasm_check="cargo check --no-default-features --features web --target wasm32-unknown-unknown"
lints="-- -D warnings -A clippy::all -D clippy::expect_used -D clippy::unwrap_used"

# 7. check.sh builds, lints, compiles the tests and checks the cluster
# unlocked, and takes the lock for the test run only.
: >"$CALLS"
if ! out=$(timeout 60 "${gate_env[@]}" scripts/check.sh 2>&1); then
    fail "check.sh with stubs failed: $out"
fi
expected="$wasm_check unlocked
cargo build --features server unlocked
cargo clippy --version unlocked
cargo clippy --features server $lints unlocked
cargo clippy --no-default-features --features web --target wasm32-unknown-unknown $lints unlocked
cargo test --features server --no-run unlocked
import unlocked
cargo test --features server locked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "check.sh's calls: $(cat "$CALLS")"
# A test build that fails stops check.sh before the lock.
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/check.sh 2>&1); then
    fail "check.sh passed with a failing test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "check.sh took the lock after a failing test build: $(cat "$CALLS")"
grep -q "stub cargo told to fail" <<<"$out" || fail "check.sh didn't show the test build's error: $out"

# 8. browser-tier likewise: the bundle, the test build and the scratch
# database unlocked, the tier's run locked.
: >"$CALLS"
if ! out=$(timeout 60 "${gate_env[@]}" scripts/browser-tier 2>&1); then
    fail "browser-tier with stubs failed: $out"
fi
tier_db=postgres://u@localhost/smelt_browser_tier_$(basename "$PWD" | tr -c 'a-zA-Z0-9\n' '_')
expected="import unlocked
dx build --platform web unlocked
cargo test --features server browser-test --no-run unlocked
sqlx database drop -y --database-url $tier_db unlocked
sqlx database create --database-url $tier_db unlocked
cargo test --features server browser-test -- --ignored --test-threads=1 locked
sqlx database drop -y --database-url $tier_db unlocked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "browser-tier's calls: $(cat "$CALLS")"
: >"$CALLS"
if out=$(timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/browser-tier 2>&1); then
    fail "browser-tier passed with a failing test build: $out"
fi
grep -q " locked$" "$CALLS" && fail "browser-tier took the lock after a failing test build: $(cat "$CALLS")"

# 9. cluster-test: the same cargo test, built with --no-run unlocked (before
# the first --, or last when there's none), then run locked.
: >"$CALLS"
timeout 60 "${gate_env[@]}" scripts/cluster-test --features server -- --exact a::b >/dev/null 2>&1 ||
    fail "cluster-test failed"
expected="cargo test --features server --no-run -- --exact a::b unlocked
cargo test --features server -- --exact a::b locked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "cluster-test's calls: $(cat "$CALLS")"
: >"$CALLS"
timeout 60 "${gate_env[@]}" scripts/cluster-test --features server sweep >/dev/null 2>&1 || fail "cluster-test without -- failed"
expected="cargo test --features server sweep --no-run unlocked
cargo test --features server sweep locked"
[ "$(cat "$CALLS")" = "$expected" ] || fail "cluster-test's calls without --: $(cat "$CALLS")"
: >"$CALLS"
timeout 60 "${gate_env[@]}" CARGO_FAIL="--no-run" scripts/cluster-test --features server >/dev/null 2>&1
rc=$?
[ "$rc" = 101 ] || fail "cluster-test with a failing build exited $rc, not the build's 101"
grep -q " locked$" "$CALLS" && fail "cluster-test took the lock after a failing build: $(cat "$CALLS")"
unset CALLS

cs_env=(env -u SANDBOX_IMAGE -u RUST_LOG -u NO_COLOR PATH="$dir/bin:$PATH" SANDBOX_IMAGE_IMPORT="$dir/bin/import"
    DATABASE_URL=postgres://u@localhost/smelt_dev)

# 10. check-server takes no cluster lock, and the server it starts never
# holds it, even when start runs under an old outer flock (SME-100).
check_server start HEAD >/dev/null || fail "start for the cluster-lock case"
lock_is_free || fail "check-server: the cluster lock is held while a check server runs"
check_server stop >/dev/null
if ! out=$(timeout 60 flock "$lock" "${cs_env[@]}" CHECK_WORKTREE="$worktree" scripts/check-server start HEAD 2>&1); then
    fail "check-server start under an outer flock: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
if [ -n "$pgid" ] && [ -d "/proc/$pgid" ]; then
    fds=$(find "/proc/$pgid/fd" -maxdepth 1 -lname "$lock" 2>/dev/null)
    [ -z "$fds" ] || fail "check-server: the server started under an outer flock holds the cluster lock: $fds"
    lock_is_free || fail "check-server: after the outer flock ended, the cluster lock is still held"
else
    fail "check-server: no server running after a start under an outer flock: '$pgid'"
fi
check_server stop >/dev/null

# 11. The port lock: held by the running server's process group, freed by
# stop or by the group dying; a second start on the same port waits for it,
# naming the first's worktree; refusals never wait.
port_lock=$SMELT_LOCK_DIR/smelt-check-server-8081.lock
port_is_free() { flock -n "$port_lock" true; }
worktree2=$dir/worktree2
[ -d "$worktree2/.git" ] || git clone -q --shared --no-checkout "$PWD" "$worktree2" || exit 1
"${cs_env[@]}" CHECK_WORKTREE="$worktree2" scripts/check-server stop >/dev/null 2>&1
check_server start HEAD >/dev/null || fail "start for the port lock"
pgid=$(cat "$pid_file" 2>/dev/null)
port_is_free && fail "check-server: the port lock is free while the server runs"
check_server stop >/dev/null
port_is_free || fail "check-server: the port lock is still held after stop"
check_server start HEAD >/dev/null || fail "start for the port lock, to kill"
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && kill -KILL -- "-$pgid"
sleep 0.5
port_is_free || fail "check-server: the port lock is still held after its server was killed"
check_server stop >/dev/null
check_server start HEAD >/dev/null || fail "start before a second one on the same port"
out=$(timeout 3 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 124 ] || fail "check-server: a second start on the same port didn't wait (exit $rc): $out"
grep -qF "waiting for port 8081: a check server from $worktree holds it" <<<"$out" ||
    fail "check-server: the second start's waiting line: $out"
[ -s "$worktree2/.check-server.pid" ] && fail "check-server: a waiting start wrote its pid file"
if ! out=$(timeout 20 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_PORT=8091 scripts/check-server start HEAD 2>&1); then
    fail "check-server: a start on another port while one runs: $out"
fi
"${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_PORT=8091 scripts/check-server stop >/dev/null 2>&1
# Refused starts exit at once, even while the port is held.
out=$(timeout 5 "${cs_env[@]}" CHECK_WORKTREE="$worktree" scripts/check-server start HEAD 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "check-server: an 'already running' start exited $rc: $out"
out=$(timeout 5 "${cs_env[@]}" CHECK_WORKTREE="$worktree2" CHECK_SCRATCH_DB=1 scripts/check-server start "$old_ref" 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "check-server: SME-115's refusal exited $rc while the port was held: $out"
check_server stop >/dev/null
# The usage text is the whole header.
header_end=$(awk '/^set -euo pipefail/ { print prev; exit } { prev = $0 }' scripts/check-server | sed 's/^# \{0,1\}//')
[ "$(scripts/check-server 2>&1 | tail -n 1)" = "$header_end" ] || fail "check-server's usage stops before the header's last line: $header_end"

# 12. clean-test-namespace.sh deletes everything in smelt-park-test, a test
# run's pods too, so it takes the cluster lock: with a python3 stub, which
# records the lock's state and its script's first line.
cat >"$dir/bin/python3" <<'EOF'
#!/usr/bin/env bash
read -r first
echo "python3 $(lock-state) $first" >>"$CALLS"
EOF
chmod +x "$dir/bin/python3"
export CALLS=$dir/calls
: >"$CALLS"
clean_env=(env PATH="$dir/bin:$PATH" KUBECONFIG=/nonexistent)
[ "$("${clean_env[@]}" bash -c 'command -v python3')" = "$dir/bin/python3" ] || {
    echo "the python3 stub isn't first on PATH; stopping before running clean-test-namespace.sh" >&2
    exit 1
}
timeout 20 "${clean_env[@]}" scripts/clean-test-namespace.sh >/dev/null 2>&1 || fail "clean-test-namespace.sh with a stub failed"
[ "$(cat "$CALLS")" = "python3 locked import base64, json, re, ssl, sys, tempfile, urllib.request" ] ||
    fail "clean-test-namespace.sh's python3: $(cat "$CALLS")"
: >"$CALLS"
flock "$lock" sleep 3 &
outer=$!
wait_until_held || fail "clean-test-namespace.sh: the outer holder never took the lock"
out=$(timeout 2 "${clean_env[@]}" scripts/clean-test-namespace.sh 2>&1)
rc=$?
wait "$outer"
[ "$rc" = 124 ] || fail "clean-test-namespace.sh didn't wait for the lock (exit $rc): $out"
grep -q "waiting for the cluster lock" <<<"$out" || fail "clean-test-namespace.sh didn't say it waits: $out"
[ -s "$CALLS" ] && fail "clean-test-namespace.sh ran while another process held the lock: $(cat "$CALLS")"
unset CALLS

if [ "$failures" -gt 0 ]; then
    echo "$failures failure(s)"
    exit 1
fi
echo "all check-script tests passed"
