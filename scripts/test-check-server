#!/usr/bin/env bash
# scripts/check-server (SME-107, SME-115, SME-117, SME-129, SME-100):
# its state files, emptied rather than removed, an empty one meaning
# "not running" or "no scratch database"; the log settings its server
# gets; that it takes no cluster lock; where its database comes from.
# The port lock and the SME-175 listener sections are in
# scripts/test-check-server-ports (split off when this file reached the
# size ceiling, SME-265); the scratch database's cleanup and the scratch
# lock are in scripts/test-check-server-scratch (SME-226). The stubs and
# helpers are in scripts/lib/test-check-scripts.sh.
#
#   scripts/test-check-server
. "$(dirname "$0")/lib/test-check-scripts.sh"

# Whatever an earlier, failed run left running.
check_server stop >/dev/null
: >"$SQLX_CALLS"

# A scratch database for a ref without SME-115's fix is refused: that
# server's sweep deletes the dev server's sandbox claims. It creates no
# database, writes no state file and starts nothing.
old_ref=$(git rev-list --max-parents=0 HEAD | tail -n 1)
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"
if out=$(CHECK_SCRATCH_DB=1 check_server start "$old_ref"); then
    fail "start with CHECK_SCRATCH_DB=1 for a ref without the fix succeeded: $out"
fi
grep -q "SME-115" <<<"$out" || fail "the refusal doesn't name SME-115: $out"
grep -q "$old_ref" <<<"$out" || fail "the refusal doesn't name the ref: $out"
[ -s "$SQLX_CALLS" ] && fail "a refused start called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$pid_file" ] && fail "a refused start wrote a pid file: '$(cat "$pid_file")'"
[ -s "$scratch_file" ] && fail "a refused start wrote a scratch file: '$(cat "$scratch_file")'"
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status after a refused start: $(check_server status)"

# The same for a commit of SME-115's own branch that has the instance
# migration but not yet the fix (its sweep isn't scoped yet).
: >"$SQLX_CALLS"
if out=$(CHECK_SCRATCH_DB=1 check_server start 7dc5248); then
    fail "start with CHECK_SCRATCH_DB=1 for a commit partway through the fix succeeded: $out"
fi
grep -q "SME-115" <<<"$out" || fail "the partway refusal doesn't name SME-115: $out"
[ -s "$SQLX_CALLS" ] && fail "a refused partway start called sqlx: $(cat "$SQLX_CALLS")"
[ -s "$scratch_file" ] && fail "a refused partway start wrote a scratch file: '$(cat "$scratch_file")'"

# start with CHECK_SCRATCH_DB=1 — the default since SME-226, and still accepted
# as saying it — for a ref with the fix: both state files written.
if ! out=$(CHECK_SCRATCH_DB=1 check_server start HEAD); then
    fail "start: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && group_is_live "$pgid" || fail "after start, the pid file names no live group: '$pgid'"
[ "$(cat "$scratch_file" 2>/dev/null)" = "$scratch_url" ] || fail "after start, the scratch file holds '$(cat "$scratch_file" 2>/dev/null)'"
grep -qx "database create --database-url $scratch_url" "$SQLX_CALLS" || fail "start didn't create the scratch database: $(cat "$SQLX_CALLS")"
grep -qF "serving from scratch database" <<<"$out" || fail "start didn't say which scratch database it serves: $out"
case "$(check_server status)" in running*) ;; *) fail "status after start: $(check_server status)" ;; esac

# stop: the group gone, the database dropped, both files kept and empty.
: >"$SQLX_CALLS"
out=$(check_server stop)
[ -n "$pgid" ] && group_is_live "$pgid" && fail "after stop, group $pgid is still running"
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "stop didn't drop the scratch database: $(cat "$SQLX_CALLS")"
for file in "$pid_file" "$scratch_file"; do
    if [ ! -e "$file" ]; then
        fail "stop removed $(basename "$file")"
    elif [ -s "$file" ]; then
        fail "after stop, $(basename "$file") holds '$(cat "$file")'"
    fi
done

# The default start serves a scratch database of the worktree's own (SME-226):
# what CHECK_SCRATCH_DB=1 used to ask for is what happens with no flag at all.
# This case was "start without a scratch database: the pid file written, no
# scratch file"; those assertions move to the CHECK_DEV_DB=1 case below, which
# is what asks for the dev database now.
: >"$CLEANUP_CALLS"
: >"$SQLX_CALLS"
: >"$pid_file"
: >"$scratch_file"
if ! out=$(check_server start HEAD); then
    fail "the default start: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
[ -n "$pgid" ] && group_is_live "$pgid" || fail "after the default start, the pid file names no live group: '$pgid'"
[ "$(cat "$scratch_file" 2>/dev/null)" = "$scratch_url" ] || fail "after the default start, the scratch file holds '$(cat "$scratch_file" 2>/dev/null)'"
grep -qx "database create --database-url $scratch_url" "$SQLX_CALLS" || fail "the default start didn't create the scratch database: $(cat "$SQLX_CALLS")"
[ -s "$CLEANUP_CALLS" ] || fail "the default start didn't clean the scratch database's sandbox objects: $(cat "$CLEANUP_CALLS")"
grep -qF "serving from scratch database" <<<"$out" || fail "the default start didn't say which database it serves: $out"
grep -qF "serving the DEV database" <<<"$out" && fail "the default start said it serves the DEV database: $out"
case "$(check_server status)" in running*) ;; *) fail "status after the default start: $(check_server status)" ;; esac
# …and says which database it serves (SME-226): the running server's own, not
# whatever the scratch file happens to record.
out=$(check_server status)
grep -qF "serving scratch database smelt_scratch_worktree," <<<"$out" ||
    fail "status doesn't say which scratch database the default start serves: $out"

# stop: the group gone, the database dropped, both files kept and empty.
: >"$SQLX_CALLS"
out=$(check_server stop)
[ -n "$pgid" ] && group_is_live "$pgid" && fail "after stop, group $pgid is still running"
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "stop didn't drop the scratch database: $(cat "$SQLX_CALLS")"
for file in "$pid_file" "$scratch_file"; do
    if [ ! -e "$file" ]; then
        fail "stop removed $(basename "$file")"
    elif [ -s "$file" ]; then
        fail "after stop, $(basename "$file") holds '$(cat "$file")'"
    fi
done
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status after stop: $(check_server status)"

# CHECK_SCRATCH_DB=1 asks for the default, so it changes nothing: the case at the
# top of this script is this one with the flag on, asserting the same scratch
# file and sqlx calls. The flag stays accepted so the docs, saved runbooks and
# Feature-checklist rows that set it keep working (SME-226 question 2).

# CHECK_DEV_DB=1 says what it serves (SME-226): the branch's migrations go to
# the dev database, which is what SME-175's hand-run start did by accident. It
# serves the dev database as a plain start does — no scratch file written, and
# nothing for stop to drop.
if ! out=$(CHECK_DEV_DB=1 check_server start HEAD); then
    fail "start with CHECK_DEV_DB=1: $out"
fi
grep -qF "serving the DEV database; the branch's migrations will be applied to it" <<<"$out" ||
    fail "CHECK_DEV_DB=1 didn't say it serves the dev database: $out"
# And status says it too, from the running server's own environment (SME-226).
out=$(check_server status)
grep -qF "serving the dev database smelt_dev," <<<"$out" ||
    fail "status doesn't say the CHECK_DEV_DB=1 server serves the dev database: $out"
[ -s "$scratch_file" ] && fail "CHECK_DEV_DB=1 left '$(cat "$scratch_file")' to drop"
: >"$SQLX_CALLS"
check_server stop >/dev/null
[ -s "$SQLX_CALLS" ] && fail "stop after CHECK_DEV_DB=1 called sqlx: $(cat "$SQLX_CALLS")"

# A CHECK_DEV_DB=1 start that goes on to be refused says nothing about the dev
# database (SME-226 review 1, finding 3): the notice printed before the
# already-running check, the port checks and the image check, so a start that
# refused anyway had told the reader the branch's migrations would be applied
# to the dev database, when nothing had been checked out, created or started.
# It is said when the start goes ahead, where the scratch one says its piece.
if ! out=$(check_server start HEAD); then
    fail "start before a refused CHECK_DEV_DB=1 start: $out"
fi
out=$(CHECK_DEV_DB=1 check_server start HEAD)
rc=$?
[ "$rc" = 1 ] || fail "a CHECK_DEV_DB=1 start while a server runs exited $rc, not 1: $out"
grep -q "already running" <<<"$out" || fail "the second start isn't the already-running refusal: $out"
grep -qF "serving the DEV database" <<<"$out" &&
    fail "a refused CHECK_DEV_DB=1 start said it serves the DEV database: $out"
check_server stop >/dev/null

# A CHECK_DEV_DB=1 start following a scratch run: the record is the scratch
# file, not the running server's kind (SME-226) — which is also why `status`
# can't tell the two kinds of server apart from it. The dev start leaves the
# earlier run's record alone and calls no sqlx; the stop that follows drops the
# scratch database that record names, this worktree's leftover to clear.
echo "$scratch_url" >"$scratch_file"
: >"$SQLX_CALLS"
if ! out=$(CHECK_DEV_DB=1 check_server start HEAD); then
    fail "start with CHECK_DEV_DB=1 over a scratch leftover: $out"
fi
[ "$(cat "$scratch_file")" = "$scratch_url" ] || fail "the dev start changed the scratch record to '$(cat "$scratch_file")'"
[ -s "$SQLX_CALLS" ] && fail "a CHECK_DEV_DB=1 start touched a database: $(cat "$SQLX_CALLS")"
: >"$SQLX_CALLS"
check_server stop >/dev/null
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "the stop after a CHECK_DEV_DB=1 start didn't drop the scratch database the earlier run recorded: $(cat "$SQLX_CALLS")"
[ -e "$scratch_file" ] && [ ! -s "$scratch_file" ] || fail "that stop left the scratch record as '$(cat "$scratch_file" 2>/dev/null)'"

# stop again: nothing running, nothing to drop.
: >"$SQLX_CALLS"
out=$(check_server stop)
grep -q "no check server running" <<<"$out" || fail "a second stop said: $out"
[ -s "$SQLX_CALLS" ] && fail "a second stop called sqlx: $(cat "$SQLX_CALLS")"

# A crashed run: a pid file naming a dead group, and a scratch database
# never dropped. status says not running, stop drops the database, and a
# start goes ahead.
dead=$(bash -c 'echo $$')
echo "$dead" >"$pid_file"
echo "$scratch_url" >"$scratch_file"
case "$(check_server status)" in "not running"*) ;; *) false ;; esac || fail "status with a dead pid: $(check_server status)"
: >"$SQLX_CALLS"
check_server stop >/dev/null
grep -qx "database drop -y --database-url $scratch_url" "$SQLX_CALLS" || fail "stop after a crash didn't drop the scratch database: $(cat "$SQLX_CALLS")"
[ -e "$pid_file" ] && [ ! -s "$pid_file" ] || fail "stop after a crash didn't leave an empty pid file"
echo "$dead" >"$pid_file"
if ! out=$(check_server start HEAD); then
    fail "start over a dead pid: $out"
fi
check_server stop >/dev/null

# Where the scratch URL's base comes from, now that every default start needs
# one (SME-226): $DATABASE_URL, else the check worktree's .env, else this
# checkout's own. A fresh check worktree has none, and start copies one in only
# after the scratch URL is built, so that third source is what makes a first
# start work in a new worktree. These cases run from a clone of this repo with
# this working tree's scripts copied over its own — the clone is of HEAD, and the
# gate runs against the working tree — so its .env is its own to write and the
# real checkout is never touched. It's a full checkout, because start's image
# check reads this repo's sources.
repo_clone=$dir/repo-env
wt_repo=$dir/wtrepoenv
[ -d "$repo_clone/.git" ] || git clone -q --shared "$PWD" "$repo_clone" || exit 1
# A working tree of its own, since start's image check reads this repo's sources
# through cluster-doctor (an earlier run may have made the clone without one),
# and --force because the copy over the top below is a change of ours.
git -C "$repo_clone" checkout -q --force --detach HEAD || exit 1
cp -a "$PWD/scripts/." "$repo_clone/scripts/"
# With DATABASE_URL unexported and both .env files emptied (what an earlier run
# left, kept and emptied rather than removed), only the repo's own .env can
# answer.
no_url_env=(env -u DATABASE_URL -u SANDBOX_IMAGE -u RUST_LOG -u NO_COLOR PATH="$dir/bin:$PATH"
    SANDBOX_IMAGE_IMPORT="$dir/bin/import" SANDBOX_INSTANCE_CLEANUP="$dir/bin/cleanup" CHECK_PORT="$port")
repo_url=postgres://repouser@localhost/smelt_repodev
repo_scratch_url=postgres://repouser@localhost/smelt_scratch_wtrepoenv

# Nothing exported, the repo's .env holding DATABASE_URL, a worktree with no
# value of its own: the start succeeds, and its scratch database is that
# server's, named after the worktree.
"${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" stop >/dev/null 2>&1
printf 'DATABASE_URL=%s\n' "$repo_url" >"$repo_clone/.env"
mkdir -p "$wt_repo"
: >"$wt_repo/.env"
: >"$SQLX_CALLS"
if ! out=$("${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" start HEAD 2>&1); then
    fail "a default start in a fresh worktree with only the repo's .env: $out"
fi
[ "$(cat "$wt_repo/.check-server.scratch-db" 2>/dev/null)" = "$repo_scratch_url" ] ||
    fail "the repo's .env didn't reach the scratch database: '$(cat "$wt_repo/.check-server.scratch-db" 2>/dev/null)', not '$repo_scratch_url'"
grep -qx "database create --database-url $repo_scratch_url" "$SQLX_CALLS" || fail "that start didn't create the scratch database the repo's .env implies: $(cat "$SQLX_CALLS")"
"${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" stop >/dev/null 2>&1
grep -qx "database drop -y --database-url $repo_scratch_url" "$SQLX_CALLS" || fail "stop didn't drop the scratch database made from the repo's .env: $(cat "$SQLX_CALLS")"

# Nothing anywhere to resolve a URL from: refused, and the message names the
# three places it looked.
echo "# no DATABASE_URL in this file" >"$repo_clone/.env"
: >"$wt_repo/.env"
: >"$wt_repo/.check-server.pid"
: >"$wt_repo/.check-server.scratch-db"
: >"$SQLX_CALLS"
out=$("${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" start HEAD 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "a start with no DATABASE_URL anywhere exited $rc: $out"
grep -qF "DATABASE_URL (environment, .env or the repo's .env)" <<<"$out" || fail "that refusal doesn't name the three places it looked: $out"
[ -s "$wt_repo/.check-server.pid" ] && fail "a start that couldn't resolve a URL wrote a pid file"
[ -s "$wt_repo/.check-server.scratch-db" ] && fail "a start that couldn't resolve a URL wrote a scratch record"
[ -s "$SQLX_CALLS" ] && fail "a start that couldn't resolve a URL called sqlx: $(cat "$SQLX_CALLS")"

# And a server already running is still reported as *that*, not as the URL
# error: the scratch lock is keyed by the database's name, which the worktree
# decides on its own, so the URL is resolved only after the running check.
if ! out=$("${no_url_env[@]}" DATABASE_URL="$repo_url" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" start HEAD 2>&1); then
    fail "the already-running case's first start, with DATABASE_URL exported: $out"
fi
out=$("${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" start HEAD 2>&1)
rc=$?
[ "$rc" = 1 ] || fail "a second start with no DATABASE_URL exited $rc: $out"
grep -q "already running" <<<"$out" || fail "a second start with no DATABASE_URL didn't report the running server: $out"
grep -qF "needs DATABASE_URL" <<<"$out" && fail "the URL error came before the already-running one: $out"
"${no_url_env[@]}" CHECK_WORKTREE="$wt_repo" "$repo_clone/scripts/check-server" stop >/dev/null 2>&1

# The log level and colour the server gets (SME-117). Each case starts a
# check server with extra_env and the given start arguments, then compares
# what the stub dx recorded, and the level start printed, with what's
# expected; then stops it. An empty value counts as unset everywhere, since
# smelt reads an empty RUST_LOG as errors only.
dx_env_after_start() {
    for _ in $(seq 1 50); do
        [ -s "$DX_ENV" ] && break
        sleep 0.1
    done
    cat "$DX_ENV" 2>/dev/null
}
expect_log_settings() { # name rust_log no_color printed [start args...]
    local name=$1 rust_log=$2 no_color=$3 printed=$4 out got
    shift 4
    : >"$DX_ENV"
    if ! out=$(check_server start HEAD "$@"); then
        fail "$name: start: $out"
    fi
    got=$(dx_env_after_start)
    [ "$got" = "$(printf 'RUST_LOG=%s\nNO_COLOR=%s' "$rust_log" "$no_color")" ] ||
        fail "$name: the server got: $(tr '\n' ' ' <<<"$got")"
    grep -qF "RUST_LOG=$rust_log ($printed)" <<<"$out" || fail "$name: start printed: $out"
    check_server stop >/dev/null
    extra_env=()
}
env_file=$worktree/.env
: >"$env_file"
expect_log_settings "no level anywhere" info 1 "check-server's default"
extra_env=(RUST_LOG=debug)
expect_log_settings "a level in the environment" debug 1 yours
extra_env=(RUST_LOG=)
expect_log_settings "an empty level in the environment" info 1 "check-server's default"
echo "RUST_LOG=warn" >"$env_file"
expect_log_settings "a level in .env" warn 1 "from .env"
# Written the ways dotenvy also reads: spaces around =, a comment after.
echo "RUST_LOG = warn" >"$env_file"
expect_log_settings "a level in .env with spaces around =" warn 1 "from .env"
echo "RUST_LOG=warn # quieter" >"$env_file"
expect_log_settings "a level in .env with a comment after it" warn 1 "from .env"
echo 'RUST_LOG="warn # not a comment"' >"$env_file"
expect_log_settings "a quoted level in .env keeps its #" "warn # not a comment" 1 "from .env"
# An empty value with a comment after it is empty to dotenvy, so the
# default applies (SME-117 review 2).
echo "RUST_LOG= # debug when needed" >"$env_file"
expect_log_settings "an empty level in .env with a comment" info 1 "check-server's default"
# dotenvy keeps the first line that sets a name (SME-117 review 2).
printf 'RUST_LOG=debug\nRUST_LOG=warn\n' >"$env_file"
expect_log_settings "a level set twice in .env" debug 1 "from .env"
# dotenvy never overrides a variable that's set, even to "", so an empty
# one in the environment would hide .env's from smelt.
echo "RUST_LOG=warn" >"$env_file"
extra_env=(RUST_LOG=)
expect_log_settings "a level in .env under an empty one in the environment" warn 1 "from .env"
: >"$env_file"
extra_env=(RUST_LOG=debug)
expect_log_settings "an override over the environment" trace 1 yours -- RUST_LOG=trace
extra_env=(RUST_LOG=debug)
expect_log_settings "an empty override" debug 1 yours -- RUST_LOG=
expect_log_settings "an empty override and nothing else" info 1 "check-server's default" -- RUST_LOG=
extra_env=(NO_COLOR=yes)
expect_log_settings "NO_COLOR in the environment" info yes "check-server's default"
expect_log_settings "NO_COLOR as an override" info no "check-server's default" -- NO_COLOR=no
: >"$env_file"

# A second start keeps the first run's log as .check-server.log.prev, and
# stop and status name the log.
: >"$DX_ENV"
check_server start HEAD >/dev/null || fail "first start for the log"
dx_env_after_start >/dev/null
first_log=$(cat "$log_file")
grep -q "stub dx started" <<<"$first_log" || fail "the first run's log holds: $first_log"
out=$(check_server status)
grep -qF "$log_file" <<<"$out" || fail "status doesn't name the log: $out"
out=$(check_server stop)
grep -qF "$log_file" <<<"$out" || fail "stop doesn't name the log: $out"
: >"$DX_ENV"
check_server start HEAD >/dev/null || fail "second start for the log"
dx_env_after_start >/dev/null
[ "$(cat "$log_file.prev" 2>/dev/null)" = "$first_log" ] ||
    fail "after a second start, .check-server.log.prev holds: $(cat "$log_file.prev" 2>/dev/null)"
[ "$(cat "$log_file")" != "$first_log" ] || fail "the second start didn't empty the log"
check_server stop >/dev/null
out=$(check_server status)
grep -qF "$log_file" <<<"$out" || fail "status when stopped doesn't name the log: $out"

# 10. check-server takes no cluster lock, and the server it starts never
# holds it, even when start runs under an old outer flock (SME-100).
check_server start HEAD >/dev/null || fail "start for the cluster-lock case"
lock_is_free || fail "check-server: the cluster lock is held while a check server runs"
check_server stop >/dev/null
if ! out=$(timeout 60 flock "$lock" "${cs_env[@]}" CHECK_WORKTREE="$worktree" scripts/check-server start HEAD 2>&1); then
    fail "check-server start under an outer flock: $out"
fi
pgid=$(cat "$pid_file" 2>/dev/null)
if [ -n "$pgid" ] && [ -d "/proc/$pgid" ]; then
    fds=$(find "/proc/$pgid/fd" -maxdepth 1 -lname "$lock" 2>/dev/null)
    [ -z "$fds" ] || fail "check-server: the server started under an outer flock holds the cluster lock: $fds"
    lock_is_free || fail "check-server: after the outer flock ended, the cluster lock is still held"
else
    fail "check-server: no server running after a start under an outer flock: '$pgid'"
fi
check_server stop >/dev/null

# The usage text is the whole header.
header_end=$(awk '/^set -euo pipefail/ { print prev; exit } { prev = $0 }' scripts/check-server | sed 's/^# \{0,1\}//')
[ "$(scripts/check-server 2>&1 | tail -n 1)" = "$header_end" ] || fail "check-server's usage stops before the header's last line: $header_end"

finish
