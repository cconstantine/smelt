# Copy to .env (gitignored) and fill in. Loaded automatically at server
# startup via dotenvy — see src/main.rs. Full reference: docs/setup.md.

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Alternative: point at a local Ollama server instead of the real Anthropic
# API — Ollama (v0.14.0+) serves an Anthropic Messages API-compatible
# endpoint at /v1/messages. ANTHROPIC_API_KEY must still be non-empty (smelt
# treats "" as unset) but its value is ignored by Ollama. ANTHROPIC_MODEL
# must be a model name you've actually pulled — Ollama won't recognize
# Anthropic's own model ids unless you `ollama cp` one to that name. Use a
# model with a context window clone (e.g. `ollama cp gpt-oss:120b
# gpt-oss:120b_128k` after `/set parameter num_ctx 131072`) since the
# vanilla default context on some models is too small for tool-calling.
# ANTHROPIC_BASE_URL=http://ryzen.lan:11434
# ANTHROPIC_API_KEY=ollama
# ANTHROPIC_MODEL=gpt-oss:120b_128k

# Alternative: an Anthropic-compatible gateway that expects bearer auth
# instead of an x-api-key header — e.g. Hugging Face's hosted Anthropic API.
# ANTHROPIC_AUTH_TOKEN takes precedence over ANTHROPIC_API_KEY if both are
# set (only one auth header is ever sent); leave ANTHROPIC_API_KEY unset.
# Fill in ANTHROPIC_BASE_URL with the gateway's own base URL.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=hf_...
# ANTHROPIC_MODEL=...

# DATABASE_URL is set in docker-compose.yml's `smelt` service; only needed
# here if running outside docker compose.
# DATABASE_URL=postgres://smelt:smelt@postgres/smelt

# PORT=8080
# RUST_LOG=info
