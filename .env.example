# Copy to .env (gitignored) and fill in. Loaded automatically at server
# startup via dotenvy — see src/main.rs. Full reference: docs/setup.md.

# Model providers (Anthropic, Ollama, or any Anthropic-compatible server)
# and the model each conversation uses are set up in the app, on
# /providers, not here (SME-72).

# DATABASE_URL is set in docker-compose.yml's `smelt` service; only needed
# here if running outside docker compose.
# DATABASE_URL=postgres://smelt:smelt@postgres/smelt

# PORT=8080
# RUST_LOG=info

# Overrides the scheme+host smelt builds an MCP OAuth redirect_uri from
# (see /mcp-servers' "Connect" flow) — by default it's derived from the
# incoming request's Host header, which is wrong if smelt sits behind a
# proxy/tunnel that doesn't forward one a browser/OAuth provider could
# actually reach. No trailing slash.
# SMELT_BASE_URL=https://smelt.example.com
